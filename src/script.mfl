// script — the registry and run history.
//
// A script is JS source stored in the database, run in a sandbox with a fixed
// host surface. This file owns everything *except* the evaluator: the
// registry, the run history, and the single seam `runScript`, which is the
// only place a JS engine is reached for. Cron and the HTTP routes both go
// through that seam, so the sandbox phase replaces one function body and
// nothing else.

func scriptSchema() (s) {
  s = "CREATE TABLE IF NOT EXISTS scripts (name TEXT PRIMARY KEY, source TEXT NOT NULL, description TEXT NOT NULL DEFAULT '', timeout_ms INTEGER NOT NULL DEFAULT 5000, allow_net TEXT NOT NULL DEFAULT '', enabled INTEGER NOT NULL DEFAULT 1, created_at TEXT NOT NULL, updated_at TEXT NOT NULL); CREATE TABLE IF NOT EXISTS script_runs (id TEXT PRIMARY KEY, name TEXT NOT NULL, status TEXT NOT NULL, took_ms INTEGER NOT NULL DEFAULT 0, error TEXT NOT NULL DEFAULT '', logs TEXT NOT NULL DEFAULT '[]', value TEXT NOT NULL DEFAULT 'null', created_at TEXT NOT NULL); CREATE INDEX IF NOT EXISTS script_runs_name ON script_runs(name, created_at DESC);"
}

// The host objects a script sees. Kept as one sorted, comma-joined string
// because it is contract: a script that probes for a capability must get the
// same answer from every build.
func sandboxSurface() (s) { s = "auth,crypto,events,files,http,id,kv,lock,log,now,store" }

type ScriptRow struct { name string  source string  description string  timeout_ms int  allow_net string  enabled int  created_at string  updated_at string }

func scriptJSON(s) (out) {
  out = "{\"name\":" + jsonQuote(s.name) + ",\"description\":" + jsonQuote(s.description) + ",\"timeout_ms\":" + str(s.timeout_ms) + ",\"allow_net\":" + typeListJSON(s.allow_net) + ",\"enabled\":"
  if s.enabled == 1 { out = out + "true" } else { out = out + "false" }
  out = out + ",\"bytes\":" + str(len(s.source)) + ",\"created_at\":" + jsonQuote(s.created_at) + ",\"updated_at\":" + jsonQuote(s.updated_at) + "}"
}

func scriptColumns() (s) { s = "SELECT name, source, description, timeout_ms, allow_net, enabled, created_at, updated_at FROM scripts" }

func createScript(db, name, source, description, timeoutMs, allowNet) (out, err) {
  out = ""
  err = ""
  if !validSegment(name) { err = "script name must be lowercase and start with a letter"  return }
  if source == "" { err = "script source is empty"  return }
  if timeoutMs <= 0 { timeoutMs = 5000 }
  stamp := nowStamp()
  sqlite_exec(db, "INSERT INTO scripts (name, source, description, timeout_ms, allow_net, enabled, created_at, updated_at) VALUES (?,?,?,CAST(? AS INTEGER),?,1,?,?) ON CONFLICT(name) DO UPDATE SET source = excluded.source, description = excluded.description, timeout_ms = excluded.timeout_ms, allow_net = excluded.allow_net, updated_at = excluded.updated_at", []string{name, source, description, str(timeoutMs), allowNet, stamp, stamp})
  s, stored := findScript(db, name)
  if !stored { err = "the script was not stored (the database may be locked by another process)"  return }
  out = scriptJSON(s)
}

func findScript(db, name) (s, found) {
  s = ScriptRow{name: "", source: "", description: "", timeout_ms: 0, allow_net: "", enabled: 0, created_at: "", updated_at: ""}
  found = false
  rows := sqlite_query(db, scriptColumns() + " WHERE name = ?", []string{name})
  if rows == "[]" { return }
  parsed := parse(rows, []ScriptRow{})
  if len(parsed) == 0 { return }
  s = parsed[0]
  found = true
}

func listScripts(db) (out, count) {
  out = "[]"
  count = 0
  rows := sqlite_query(db, scriptColumns() + " ORDER BY name")
  if rows == "[]" { return }
  parsed := parse(rows, []ScriptRow{})
  parts := []string{}
  i := 0
  while i < len(parsed) {
    parts = append(parts, scriptJSON(parsed[i]))
    i = i + 1
  }
  count = len(parsed)
  out = "[" + join(parts, ",") + "]"
}

func deleteScript(db, name) (err) {
  err = ""
  _, found := findScript(db, name)
  if !found { err = "script not found"  return }
  sqlite_exec(db, "DELETE FROM scripts WHERE name = ?", []string{name})
}

func recordRun(db, name, status, tookMs, runErr, logs, value) (id) {
  id = newID()
  if logs == "" { logs = "[]" }
  if value == "" { value = "null" }
  sqlite_exec(db, "INSERT INTO script_runs (id, name, status, took_ms, error, logs, value, created_at) VALUES (?,?,?,CAST(? AS INTEGER),?,?,?,?)", []string{id, name, status, str(tookMs), runErr, logs, value, nowStamp()})
}

type RunRow struct { id string  name string  status string  took_ms int  error string  logs string  value string  created_at string }

func listRuns(db, name, limit) (out, count) {
  out = "[]"
  count = 0
  rows := sqlite_query(db, "SELECT id, name, status, took_ms, error, logs, value, created_at FROM script_runs WHERE name = ? ORDER BY created_at DESC, id DESC LIMIT CAST(? AS INTEGER)", []string{name, str(limit)})
  if rows == "[]" { return }
  parsed := parse(rows, []RunRow{})
  parts := []string{}
  i := 0
  while i < len(parsed) {
    r := parsed[i]
    parts = append(parts, "{\"id\":" + jsonQuote(r.id) + ",\"status\":" + jsonQuote(r.status) + ",\"took_ms\":" + str(r.took_ms) + ",\"error\":" + jsonQuote(r.error) + ",\"logs\":" + r.logs + ",\"value\":" + r.value + ",\"created_at\":" + jsonQuote(r.created_at) + "}")
    i = i + 1
  }
  count = len(parsed)
  out = "[" + join(parts, ",") + "]"
}

// --- the sandbox ----------------------------------------------------------
//
// The evaluator is QuickJS, vendored and linked statically (vendor/). Exactly
// one symbol crosses in each direction: JS calls `__host(op, argsJSON)`, which
// calls `hostCall` below. Every capability is dispatched here in MFL rather
// than in C, so adding one never touches the bridge.
//
// hostCall is re-entrant from C in the middle of an eval, and the run context
// reaches it as arguments. It used to reach it through package globals, which
// is wrong the moment two runs overlap: each set the globals on entry and
// cleared them on exit, so whichever finished first unbound the other, and the
// loser answered "no datastore bound to this run" -- about half of concurrent
// hook requests. There is no per-goroutine storage in MFL to hide it in
// either, so the context travels with the call: MFL hands it to bkn_js_eval,
// C keeps it in that eval's own struct, and it comes back on every host call.

func argAt(argsJSON, i) (out) {
  out = ""
  v, e := json_get(argsJSON, "[" + str(i) + "]")
  if e != "" { return }
  out = unescape(unquote(v))
}

// argRaw keeps a JSON value as JSON — for an object or array argument, where
// unquoting would corrupt it.
func argRaw(argsJSON, i) (out) {
  out = "null"
  v, e := json_get(argsJSON, "[" + str(i) + "]")
  if e != "" { return }
  out = v
}

func hostOK(valueJSON) (out) { out = "{\"ok\":true,\"value\":" + valueJSON + "}" }
func hostErr(message) (out) { out = "{\"ok\":false,\"error\":" + jsonQuote(message) + "}" }

// hostCall is the whole host surface. `export` marks it a reachability root:
// nothing in MFL calls it, so without that the compiler would eliminate it and
// the bridge would fail to link (see finding 12).
export func hostCall(op, argsJSON, db, name, net) (out) {
  if db == 0 { out = hostErr("no datastore bound to this run")  return }

  if op == "crypto.hmac" { out = hostOK(jsonQuote(hmac_sha256(argAt(argsJSON, 0), argAt(argsJSON, 1))))  return }
  if op == "crypto.sha256" { out = hostOK(jsonQuote(sha256(argAt(argsJSON, 0))))  return }
  if op == "crypto.randomHex" {
    n := 16
    if looksNumeric(argRaw(argsJSON, 0)) { n = int(parse(argRaw(argsJSON, 0), 0)) }
    if n <= 0 { n = 16 }
    if n > 64 { n = 64 }
    out = hostOK(jsonQuote(to_hex(rand_bytes(n))))
    return
  }
  // Compared without an early exit, so the answer takes the same time
  // whatever the inputs are — the whole point of offering it at all.
  if op == "crypto.equal" {
    a := argAt(argsJSON, 0)
    b := argAt(argsJSON, 1)
    same := 0
    if len(a) != len(b) { same = 1 }
    i := 0
    while i < len(a) {
      if i < len(b) {
        if substr(a, i, i+1) != substr(b, i, i+1) { same = same + 1 }
      }
      i = i + 1
    }
    if same == 0 { out = hostOK("true") } else { out = hostOK("false") }
    return
  }

  if op == "id.new" { out = hostOK(jsonQuote(newID()))  return }
  if op == "now" {
    unit := argAt(argsJSON, 0)
    if unit == "unix" { out = hostOK(str(now()))  return }
    if unit == "ms" { out = hostOK(str(now_ms()))  return }
    out = hostOK(jsonQuote(nowStamp()))
    return
  }

  if op == "log" {
    level := argAt(argsJSON, 0)
    if !validLevel(level) { level = "info" }
    data := argRaw(argsJSON, 2)
    if data == "null" { data = "{}" }
    _, err := emitEvent(db, "script", "script.log", level, name, argAt(argsJSON, 1), data)
    if err != "" { out = hostErr(err)  return }
    out = hostOK("true")
    return
  }

  if op == "events.emit" {
    opts := argRaw(argsJSON, 2)
    level := jsonField(opts, ".level")
    subject := jsonField(opts, ".subject")
    data, dataErr := json_get(opts, ".data")
    if dataErr != "" { data = "{}" }
    o, err := emitEvent(db, argAt(argsJSON, 0), argAt(argsJSON, 1), level, name, subject, data)
    if err != "" { out = hostErr(err)  return }
    out = hostOK(o)
    return
  }

  // A script asked for a setting, not a row about a setting: kv.get returns
  // the value. A json entry comes back as the object it holds; everything
  // else as a string.
  if op == "kv.get" {
    entry, found, err := kvGet(db, argAt(argsJSON, 0))
    if err != "" { out = hostErr(err)  return }
    if !found { out = hostOK("null")  return }
    kind := jsonField(entry, ".type")
    value, vErr := json_get(entry, ".value")
    if vErr != "" { out = hostOK("null")  return }
    if kind == "json" { out = hostOK(unescape(unquote(value)))  return }
    out = hostOK(value)
    return
  }
  if op == "kv.set" {
    opts := argRaw(argsJSON, 2)
    kind := jsonField(opts, ".type")
    if kind == "" { kind = "string" }
    value := argAt(argsJSON, 1)
    if kind == "json" { value = argRaw(argsJSON, 1) }
    e, err := kvSet(db, argAt(argsJSON, 0), value, kind, jsonField(opts, ".description"), jsonField(opts, ".public") == "true")
    if err != "" { out = hostErr(err)  return }
    out = hostOK(e)
    return
  }
  if op == "kv.delete" {
    if kvDelete(db, argAt(argsJSON, 0)) { out = hostOK("true") } else { out = hostOK("false") }
    return
  }
  if op == "kv.list" { out = hostOK(kvList(db, argAt(argsJSON, 0), false))  return }

  if op == "store.get" {
    ns, coll, refErr := splitRef(argAt(argsJSON, 0))
    if refErr != "" { out = hostErr(refErr)  return }
    doc, found := getDoc(db, ns, coll, argAt(argsJSON, 1))
    if !found { out = hostOK("null")  return }
    out = hostOK(doc)
    return
  }
  if op == "store.put" {
    ns, coll, refErr := splitRef(argAt(argsJSON, 0))
    if refErr != "" { out = hostErr(refErr)  return }
    doc, err := putDoc(db, ns, coll, argAt(argsJSON, 2), argRaw(argsJSON, 1))
    if err != "" { out = hostErr(err)  return }
    out = hostOK(doc)
    return
  }
  // putIfAbsent answers null when the id was already there. That is what
  // makes a webhook retry safe: the second delivery is distinguishable from
  // the first without a read-then-write race.
  if op == "store.putIfAbsent" {
    ns, coll, refErr := splitRef(argAt(argsJSON, 0))
    if refErr != "" { out = hostErr(refErr)  return }
    doc, created, err := putIfAbsent(db, ns, coll, argAt(argsJSON, 2), argRaw(argsJSON, 1))
    if err != "" { out = hostErr(err)  return }
    if !created { out = hostOK("null")  return }
    out = hostOK(doc)
    return
  }
  if op == "store.patch" {
    ns, coll, refErr := splitRef(argAt(argsJSON, 0))
    if refErr != "" { out = hostErr(refErr)  return }
    doc, found, err := patchDoc(db, ns, coll, argAt(argsJSON, 1), argRaw(argsJSON, 2))
    if err != "" { out = hostErr(err)  return }
    if !found { out = hostOK("null")  return }
    out = hostOK(doc)
    return
  }
  if op == "store.delete" {
    ns, coll, refErr := splitRef(argAt(argsJSON, 0))
    if refErr != "" { out = hostErr(refErr)  return }
    if deleteDoc(db, ns, coll, argAt(argsJSON, 1)) { out = hostOK("true") } else { out = hostOK("false") }
    return
  }
  if op == "store.list" {
    ns, coll, refErr := splitRef(argAt(argsJSON, 0))
    if refErr != "" { out = hostErr(refErr)  return }
    opts := argRaw(argsJSON, 1)
    out = hostOK(listJSON(db, ns, coll, optFilters(db, opts), jsonField(opts, ".order_by"), jsonField(opts, ".order") != "asc", optInt(opts, ".limit", 50), optInt(opts, ".offset", 0)))
    return
  }
  if op == "store.find" {
    ns, coll, refErr := splitRef(argAt(argsJSON, 0))
    if refErr != "" { out = hostErr(refErr)  return }
    doc, found := findDoc(db, ns, coll, optFilters(db, argRaw(argsJSON, 1)))
    if !found { out = hostOK("null")  return }
    out = hostOK(doc)
    return
  }
  if op == "store.count" {
    ns, coll, refErr := splitRef(argAt(argsJSON, 0))
    if refErr != "" { out = hostErr(refErr)  return }
    out = hostOK(str(countDocs(db, ns, coll, optFilters(db, argRaw(argsJSON, 1)))))
    return
  }

  if op == "events.prune" {
    removed, err := pruneEvents(db, argAt(argsJSON, 1), argAt(argsJSON, 0))
    if err != "" { out = hostErr(err)  return }
    out = hostOK(str(removed))
    return
  }
  if op == "events.list" {
    opts := argRaw(argsJSON, 1)
    evts, _, err := listEvents(db, argAt(argsJSON, 0), jsonField(opts, ".type"), jsonField(opts, ".level"), jsonField(opts, ".source"), jsonField(opts, ".subject"), jsonField(opts, ".since"), jsonField(opts, ".until"), optInt(opts, ".limit", 50), optInt(opts, ".offset", 0))
    if err != "" { out = hostErr(err)  return }
    out = hostOK(evts)
    return
  }

  if op == "lock.acquire" {
    ttl := 300
    if looksNumeric(argRaw(argsJSON, 1)) { ttl = int(parse(argRaw(argsJSON, 1), 0)) }
    owner, ok := acquireLock(db, argAt(argsJSON, 0), ttl)
    if !ok { out = hostOK("null")  return }
    out = hostOK("{\"key\":" + jsonQuote(argAt(argsJSON, 0)) + ",\"owner\":" + jsonQuote(owner) + "}")
    return
  }
  if op == "lock.release" {
    if releaseLock(db, argAt(argsJSON, 0), argAt(argsJSON, 1)) { out = hostOK("true") } else { out = hostOK("false") }
    return
  }

  // The only way out of the sandbox. A script may reach the network solely
  // through here, and only to a host its allow-net list names.
  if op == "http.fetch" {
    url := argAt(argsJSON, 0)
    if !netAllowed(net, url) { out = hostErr("host is not in this script's allow-net list: " + url)  return }
    opts := argRaw(argsJSON, 1)
    method := jsonField(opts, ".method")
    if method == "" { method = "GET" }
    body, bodyErr := json_get(opts, ".body")
    if bodyErr != "" { body = "" }
    if method == "GET" {
      out = hostOK(jsonQuote(https_get(url)))
      return
    }
    out = hostOK(jsonQuote(https_post(url, body)))
    return
  }

  out = hostErr("unknown host capability: " + op)
}

// optFilters turns a script's { where: { field: value } } into the same
// filter list the HTTP surface builds, so a query means the same thing from
// either side.
func optFilters(db, opts) (out) {
  out = []Filter{}
  where, err := json_get(opts, ".where")
  if err != "" { return }
  // MFL has no way to enumerate a JSON object's keys, so SQLite's json_each
  // does it. Only `key` is selected: json_each's `value` column is the SQL
  // value for scalars, which json() then refuses for strings.
  rows := sqlite_query(db, "SELECT key AS k, 0 AS n FROM json_each(?)", []string{where})
  if rows == "[]" { return }
  parsed := parse(rows, []GroupRow{})
  i := 0
  while i < len(parsed) {
    k := parsed[i].k
    v, e := json_get(where, "." + k)
    if e == "" {
      raw := unescape(unquote(v))
      op := "eq"
      value := raw
      colon := index(raw, ":")
      if colon > 0 {
        candidate := substr(raw, 0, colon)
        if isOperator(candidate) {
          op = candidate
          value = substr(raw, colon+1, len(raw))
        }
      }
      out = append(out, Filter{field: k, op: op, value: value})
    }
    i = i + 1
  }
}

func optInt(opts, path, fallback) (n) {
  n = fallback
  v, e := json_get(opts, path)
  if e != "" { return }
  if looksNumeric(v) { n = int(parse(v, 0)) }
}

// netAllowed: an empty list means no network at all. Reaching out is opt-in
// per script, named host by named host.
func netAllowed(csv, url) (ok) {
  ok = false
  if csv == "" { return }
  hostPart := url
  if has_prefix(hostPart, "https://") { hostPart = substr(hostPart, 8, len(hostPart)) }
  if has_prefix(hostPart, "http://") { hostPart = substr(hostPart, 7, len(hostPart)) }
  slash := index(hostPart, "/")
  if slash > 0 { hostPart = substr(hostPart, 0, slash) }
  for _, h := range split(csv, ",") {
    if trim(h) == hostPart { ok = true  return }
    if trim(h) == "*" { ok = true  return }
  }
}

// runScript evaluates a stored script. The registry, the history and the
// timeout are enforced here; the sandbox's shape is the prelude in
// vendor/bkn_qjs.c.
func runScript(db, name, input) (value, err) {
  value = "null"
  err = ""
  s, found := findScript(db, name)
  if !found { err = "script not found"  return }
  if s.enabled != 1 { err = "script is disabled" return }
  if input == "" { input = "{}" }

  started := now_ms()
  raw := bkn_js_eval(s.source, input, s.timeout_ms, 0, db, name, s.allow_net)
  took := now_ms() - started

  ok, _ := json_get(raw, ".ok")
  logs, logErr := json_get(raw, ".logs")
  if logErr != "" { logs = "[]" }
  if ok != "true" {
    err = jsonField(raw, ".error")
    if err == "" { err = "the script failed with no message" }
    recordRun(db, name, "error", took, err, logs, "null")
    return
  }
  v, vErr := json_get(raw, ".value")
  if vErr != "" { v = "null" }
  value = v
  recordRun(db, name, "ok", took, "", logs, value)
}
