// ULID: 26 chars, Crockford base32, 48-bit millisecond timestamp + 80 bits of
// randomness. The contract calls for ids that sort by creation time "including
// within one millisecond", so the random field is incremented rather than
// redrawn when two ids are minted in the same millisecond.
//
// That shared counter is the whole difficulty, and two rules govern it here.
// Both were learned from a crash (see AGENTS.md):
//
//  1. The state is scalars, never a slice. A global holding arena-allocated
//     memory is valid only for the lifetime of the goroutine that allocated
//     it: machin frees a goroutine's arena when it ends, so the previous
//     `var ulidRand = []int{}` turned into a use-after-free the moment a
//     second request arrived. The 80 random bits therefore live in two
//     integers, 40 bits each.
//
//  2. Access is serialized. machin has no mutex and no buffered channel, so
//     the lock is a keeper goroutine that hands a token out and takes it back.
//     Without it two callers landing in the same millisecond both read the
//     same counter and mint the same id.
//
// The lock covers only the counter. Formatting the id touches nothing shared,
// so it happens after the token goes back.

var ulidTok = make(chan int)
var ulidLastMs = 0
var ulidRandHi = 0
var ulidRandLo = 0

// 2^40, the width of each half; 2^39 clears the top bit of the field so a long
// burst inside one millisecond cannot carry into the timestamp.
func ulidHalf()    (n) { n = 1099511627776 }
func ulidHalfHigh() (n) { n = 549755813888 }

// ulidKeeper is the lock. It must be running before the first newID(), which
// is why main() starts it before doing anything else; a `<-ulidTok` with no
// keeper is a deadlock, and machin will say so.
func ulidKeeper() {
  while true {
    ulidTok <- 1
    _ = <-ulidTok
  }
}

func ulidCrockford() (s) { s = "0123456789ABCDEFGHJKMNPQRSTVWXYZ" }

func ulidBumpRandom() {
  ulidRandLo = ulidRandLo + 1
  if ulidRandLo < ulidHalf() { return }
  ulidRandLo = 0
  ulidRandHi = ulidRandHi + 1
  if ulidRandHi < ulidHalf() { return }
  ulidRandHi = 0
}

func ulidFreshRandom() {
  b := rand_bytes(10)
  hi := 0
  i := 0
  while i < 5 {
    hi = hi * 256 + byte_at(b, i)
    i = i + 1
  }
  lo := 0
  while i < 10 {
    lo = lo * 256 + byte_at(b, i)
    i = i + 1
  }
  ulidRandHi = hi % ulidHalfHigh()
  ulidRandLo = lo
}

// ulidByteOf reads byte i (0..9) of the 80-bit field held as two halves. It
// takes the halves as arguments rather than reading the globals, so the caller
// can work from a snapshot taken under the lock.
func ulidByteOf(hi, lo, i) (out) {
  v := hi
  j := i
  if i >= 5 {
    v = lo
    j = i - 5
  }
  shift := 1
  k := 0
  while k < 4 - j {
    shift = shift * 256
    k = k + 1
  }
  out = (v / shift) % 256
}

func newID() (out) {
  // --- critical section: advance the counter and take a snapshot ---
  _ = <-ulidTok
  ms := now_ms()
  if ms == ulidLastMs {
    ulidBumpRandom()
  } else {
    ulidLastMs = ms
    ulidFreshRandom()
  }
  hi := ulidRandHi
  lo := ulidRandLo
  ulidTok <- 1
  // --- everything below is local ---

  // 16 bytes: 6 of timestamp (big-endian) then 10 random
  bytes := []int{}
  i := 5
  while i >= 0 {
    shift := 1
    j := 0
    while j < i { shift = shift * 256  j = j + 1 }
    bytes = append(bytes, (ms / shift) % 256)
    i = i - 1
  }
  i = 0
  while i < 10 {
    bytes = append(bytes, ulidByteOf(hi, lo, i))
    i = i + 1
  }

  // 128 bits -> 26 base32 chars, high bits first
  alphabet := ulidCrockford()
  chars := []string{}
  i = 0
  while i < 26 { chars = append(chars, "0")  i = i + 1 }
  acc := 0
  bits := 0
  pos := 25
  i = 15
  while i >= 0 {
    shift := 1
    j := 0
    while j < bits { shift = shift * 2  j = j + 1 }
    acc = acc + bytes[i] * shift
    bits = bits + 8
    while bits >= 5 {
      chars[pos] = substr(alphabet, acc % 32, acc % 32 + 1)
      pos = pos - 1
      acc = acc / 32
      bits = bits - 5
    }
    i = i - 1
  }
  if pos >= 0 { chars[pos] = substr(alphabet, acc % 32, acc % 32 + 1) }
  out = join(chars, "")
}
