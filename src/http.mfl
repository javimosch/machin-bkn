// http — the request surface. Paths carry their query string, so both are
// parsed here rather than trusting a router.

type Query struct { keys []string  vals []string }

func pathOnly(p) (out) {
  out = p
  at := index(p, "?")
  if at >= 0 { out = substr(p, 0, at) }
}

// MFL has charat (index -> character) but no chr (code -> character), so a
// percent-escape is resolved through a literal table of printable ASCII
// rather than constructed. Bytes outside 32..126 are left escaped: decoding
// those means reassembling UTF-8 from raw bytes, which needs a chr.
func asciiTable() (s) {
  s = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
}

func fromCode(n) (c) {
  c = ""
  if n < 32 { return }
  if n > 126 { return }
  c = substr(asciiTable(), n - 32, n - 31)
}

func urlDecode(s) (out) {
  work := replace(s, "+", " ")
  out = ""
  i := 0
  while i < len(work) {
    c := substr(work, i, i+1)
    if c == "%" {
      if i + 3 <= len(work) {
        ch := fromCode(hexVal(substr(work, i+1, i+3)))
        if ch != "" {
          out = out + ch
          i = i + 3
          continue
        }
      }
    }
    out = out + c
    i = i + 1
  }
}

func hexDigit(c) (v) {
  v = 0
  if c >= "0" { if c <= "9" { v = int(parse(c, 0)) } }
  lc := to_lower(c)
  if lc == "a" { v = 10 }
  if lc == "b" { v = 11 }
  if lc == "c" { v = 12 }
  if lc == "d" { v = 13 }
  if lc == "e" { v = 14 }
  if lc == "f" { v = 15 }
}

func hexVal(h) (v) { v = hexDigit(substr(h, 0, 1)) * 16 + hexDigit(substr(h, 1, 2)) }

func parseQuery(p) (q) {
  q = Query{keys: []string{}, vals: []string{}}
  at := index(p, "?")
  if at < 0 { return }
  raw := substr(p, at+1, len(p))
  pairs := split(raw, "&")
  i := 0
  while i < len(pairs) {
    pair := pairs[i]
    if pair != "" {
      eq := index(pair, "=")
      if eq < 0 {
        q.keys = append(q.keys, urlDecode(pair))
        q.vals = append(q.vals, "")
      } else {
        q.keys = append(q.keys, urlDecode(substr(pair, 0, eq)))
        q.vals = append(q.vals, urlDecode(substr(pair, eq+1, len(pair))))
      }
    }
    i = i + 1
  }
}

func qGet(q, name) (v) {
  v = ""
  i := 0
  while i < len(q.keys) {
    if q.keys[i] == name { v = q.vals[i]  return }
    i = i + 1
  }
}

func qInt(q, name, fallback) (n) {
  n = fallback
  v := qGet(q, name)
  if v == "" { return }
  if looksNumeric(v) { n = int(parse(v, 0)) }
}

func segments(p) (out) {
  out = []string{}
  parts := split(pathOnly(p), "/")
  i := 0
  while i < len(parts) {
    if parts[i] != "" { out = append(out, parts[i]) }
    i = i + 1
  }
}

// A query parameter may carry an operator: ?price=gt:20, ?status=in:a,b
func filtersFrom(q) (out) {
  out = []Filter{}
  i := 0
  while i < len(q.keys) {
    k := q.keys[i]
    reserved := false
    if k == "limit" { reserved = true }
    if k == "offset" { reserved = true }
    if k == "order_by" { reserved = true }
    if k == "order" { reserved = true }
    if k == "id_only" { reserved = true }
    if !reserved {
      raw := q.vals[i]
      op := "eq"
      value := raw
      colon := index(raw, ":")
      if colon > 0 {
        candidate := substr(raw, 0, colon)
        if isOperator(candidate) {
          op = candidate
          value = substr(raw, colon+1, len(raw))
        }
      }
      out = append(out, Filter{field: k, op: op, value: value})
    }
    i = i + 1
  }
}

func isOperator(s) (ok) {
  ok = false
  if s == "eq" { ok = true }
  if s == "ne" { ok = true }
  if s == "gt" { ok = true }
  if s == "gte" { ok = true }
  if s == "lt" { ok = true }
  if s == "lte" { ok = true }
  if s == "in" { ok = true }
}

// --- responses ------------------------------------------------------------

func jsonRes(status, body) (r) { r = response(status, "application/json; charset=utf-8", body) }

func errRes(status, kind, message) (r) {
  r = jsonRes(status, "{\"ok\":false,\"error\":{\"message\":" + jsonQuote(message) + ",\"type\":" + jsonQuote(kind) + "}}")
}

// --- JSON strings ---------------------------------------------------------
//
// A request body reaches a script inside a JSON document, so it has to be a
// well-formed JSON string literal on the way in and be decoded exactly on the
// way out. Escaping only quotes and backslashes is not enough: a body with a
// newline in it — every pretty-printed webhook payload — would produce JSON
// the sandbox cannot parse.

func hexDigits() (s) { s = "0123456789abcdef" }

func hexByte(n) (s) {
  d := hexDigits()
  s = substr(d, n / 16, n / 16 + 1) + substr(d, n % 16, n % 16 + 1)
}

func jsonQuote(s) (out) {
  b := bytes(s)
  parts := []string{}
  i := 0
  while i < len(b) {
    c := byte_at(b, i)
    if c == 34 {
      parts = append(parts, "\\\"")
    } else {
      if c == 92 {
        parts = append(parts, "\\\\")
      } else {
        if c == 10 {
          parts = append(parts, "\\n")
        } else {
          if c == 13 {
            parts = append(parts, "\\r")
          } else {
            if c == 9 {
              parts = append(parts, "\\t")
            } else {
              if c < 32 {
                parts = append(parts, "\\u00" + hexByte(c))
              } else {
                parts = append(parts, substr(s, i, i + 1))
              }
            }
          }
        }
      }
    }
    i = i + 1
  }
  out = "\"" + join(parts, "") + "\""
}

// utf8Hex renders a code point as the hex of its UTF-8 bytes, so from_hex can
// turn it back into a string. MFL has no chr(), and bytes_str stops at a NUL,
// so this is the way to materialise a character from a \u escape.
func utf8Hex(cp) (h) {
  if cp < 128 { h = hexByte(cp)  return }
  if cp < 2048 {
    h = hexByte(192 + cp / 64) + hexByte(128 + cp % 64)
    return
  }
  h = hexByte(224 + cp / 4096) + hexByte(128 + (cp / 64) % 64) + hexByte(128 + cp % 64)
}

func hexNibble(ch) (n) {
  n = 0
  d := index(hexDigits(), to_lower(ch))
  if d >= 0 { n = d }
}

// jsonUnquote decodes a JSON string literal (quotes included) back to its
// bytes. Scanned rather than replaced in sequence, because a literal
// backslash followed by an n is not a newline.
func jsonUnquote(lit) (out) {
  out = ""
  s := lit
  if len(s) >= 2 {
    if substr(s, 0, 1) == "\"" { s = substr(s, 1, len(s) - 1) }
  }
  i := 0
  while i < len(s) {
    ch := substr(s, i, i + 1)
    if ch != "\\" {
      out = out + ch
      i = i + 1
      continue
    }
    nxt := substr(s, i + 1, i + 2)
    i = i + 2
    if nxt == "n" { out = out + bytes_str(from_hex("0a"))  continue }
    if nxt == "r" { out = out + bytes_str(from_hex("0d"))  continue }
    if nxt == "t" { out = out + bytes_str(from_hex("09"))  continue }
    if nxt == "b" { out = out + bytes_str(from_hex("08"))  continue }
    if nxt == "f" { out = out + bytes_str(from_hex("0c"))  continue }
    if nxt == "u" {
      cp := hexNibble(substr(s, i, i + 1)) * 4096 + hexNibble(substr(s, i + 1, i + 2)) * 256 + hexNibble(substr(s, i + 2, i + 3)) * 16 + hexNibble(substr(s, i + 3, i + 4))
      i = i + 4
      // A surrogate pair is one character written as two escapes; decoding
      // them separately yields two invalid ones.
      if cp >= 55296 {
        if cp < 56320 {
          if substr(s, i, i + 2) == "\\u" {
            lo := hexNibble(substr(s, i + 2, i + 3)) * 4096 + hexNibble(substr(s, i + 3, i + 4)) * 256 + hexNibble(substr(s, i + 4, i + 5)) * 16 + hexNibble(substr(s, i + 5, i + 6))
            if lo >= 56320 {
              if lo < 57344 {
                cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
                i = i + 6
                out = out + bytes_str(from_hex(utf8Hex4(cp)))
                continue
              }
            }
          }
        }
      }
      out = out + bytes_str(from_hex(utf8Hex(cp)))
      continue
    }
    out = out + nxt
  }
}

func utf8Hex4(cp) (h) {
  h = hexByte(240 + cp / 262144) + hexByte(128 + (cp / 4096) % 64) + hexByte(128 + (cp / 64) % 64) + hexByte(128 + cp % 64)
}

// --- auth -----------------------------------------------------------------

func bearer(req) (tok) {
  tok = ""
  h := header(req, "authorization")
  if len(h) > 7 {
    if substr(h, 0, 7) == "Bearer " { tok = substr(h, 7, len(h)) }
  }
}

// A request that arrived through a reverse proxy is not a local one, so it
// never inherits the trust a direct loopback caller would get.
func proxied(req) (yes) {
  yes = false
  if header(req, "x-forwarded-for") != "" { yes = true }
  if header(req, "x-forwarded-host") != "" { yes = true }
  if header(req, "x-real-ip") != "" { yes = true }
  if header(req, "forwarded") != "" { yes = true }
  if header(req, "x-forwarded-proto") != "" { yes = true }
}

func authed(req, adminToken, host) (ok) {
  ok = false
  if adminToken == "" {
    if host == "127.0.0.1" { if !proxied(req) { ok = true } }
    return
  }
  if bearer(req) == adminToken { ok = true }
}
