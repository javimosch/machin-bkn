  cmds = append(cmds, "\"auth user create\":{\"args\":[\"email\"],\"flags\":[\"--password-stdin\",\"--password <p>\",\"--name <n>\"]}")
  cmds = append(cmds, "\"auth user list\":{\"args\":[],\"flags\":[]}")
