  cmds = append(cmds, "\"events emit\":{\"args\":[\"stream\",\"type\"],\"flags\":[\"--level <l>\",\"--subject <s>\",\"--data <json>\"]}")
  cmds = append(cmds, "\"events list\":{\"args\":[\"stream\"],\"flags\":[\"--level <l>\",\"--since <age>\",\"--limit <n>\"]}")
  cmds = append(cmds, "\"events stats\":{\"args\":[\"stream\"],\"flags\":[\"--by <type|level|source|subject>\",\"--since <age>\"]}")
