
// The subcommands the acceptance suites need for setup. Writing identities is
// operator work, so there is no HTTP route for it.
func runCLI(a) (code) {
  code = 0
  path := env("BKN_DATA")
  if path == "" { path = "bkn.db" }
  db := storeOpen(path)
  // The CLI writes the same store the server does, so it runs the same
  // migrations -- otherwise `script update --run-access` against an older
  // database would fail on a column the server would have added.
  accessMigrate(db)
  scriptMigrate(db)
  if db == 0 { println("cannot open " + path)  code = 110  return }

  if a[1] == "auth" {
    if a[2] == "user" {
      if a[3] == "create" {
        password := ""
        name := ""
        role := "user"
        i := 5
        while i < len(a) {
          if a[i] == "--password-stdin" { password = trim(read_stdin()) }
          if a[i] == "--name" { if i+1 < len(a) { name = a[i+1] } }
          if a[i] == "--password" { if i+1 < len(a) { password = a[i+1] } }
          if a[i] == "--role" { if i+1 < len(a) { role = a[i+1] } }
          i = i + 1
        }
        user, err := createUser(db, a[4], password, name, role)
        if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
        println("{\"ok\":true,\"user\":" + user + "}")
        return
      }
    }
    if a[2] == "org" {
      if a[3] == "create" {
        name := ""
        i := 5
        while i < len(a) {
          if a[i] == "--name" { if i+1 < len(a) { name = a[i+1] } }
          i = i + 1
        }
        org, err := createOrg(db, a[4], name)
        if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
        println("{\"ok\":true,\"org\":" + org + "}")
        return
      }
    }
    if a[2] == "member" {
      if a[3] == "add" {
        role := "member"
        i := 6
        while i < len(a) {
          if a[i] == "--role" { if i+1 < len(a) { role = a[i+1] } }
          i = i + 1
        }
        err := addMember(db, a[4], a[5], role)
        if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
        println("{\"ok\":true,\"membership\":{\"org\":" + jsonQuote(a[4]) + ",\"user\":" + jsonQuote(a[5]) + ",\"role\":" + jsonQuote(role) + "}}")
        return
      }
    }
  }
  if a[1] == "files" {
    if a[2] == "ns" {
      if a[3] == "create" {
        backend := "local"
        maxBytes := 0
        allow := []string{}
        public := false
        i := 5
        while i < len(a) {
          if a[i] == "--public" { public = true }
          if a[i] == "--backend" { if i+1 < len(a) { backend = a[i+1] } }
          if a[i] == "--max-bytes" { if i+1 < len(a) { maxBytes = parse_int(a[i+1]) } }
          // repeatable: each --allow-type adds one type to the namespace
          if a[i] == "--allow-type" { if i+1 < len(a) { allow = append(allow, a[i+1]) } }
          i = i + 1
        }
        out, err := createNs(db, a[4], backend, maxBytes, join(allow, ","), public)
        if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
        println("{\"ok\":true,\"namespace\":" + out + "}")
        return
      }
      if a[3] == "list" {
        nss := listNs(db)
        println("{\"ok\":true,\"count\":" + str(countArray(db, nss)) + ",\"namespaces\":" + nss + "}")
        return
      }
      if a[3] == "delete" {
        err := deleteNs(db, a[4])
        if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
        println("{\"ok\":true,\"deleted\":true}")
        return
      }
    }
  }

  if a[1] == "cron" {
    if a[2] == "create" {
      schedule := ""
      script := ""
      input := "{}"
      i := 4
      while i < len(a) {
        if a[i] == "--schedule" { if i+1 < len(a) { schedule = a[i+1] } }
        if a[i] == "--script" { if i+1 < len(a) { script = a[i+1] } }
        if a[i] == "--input" { if i+1 < len(a) { input = a[i+1] } }
        i = i + 1
      }
      out, err := createJob(db, a[3], schedule, script, input)
      if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
      println("{\"ok\":true,\"job\":" + out + "}")
      return
    }
    if a[2] == "list" {
      jobs, count := listJobs(db)
      println("{\"ok\":true,\"count\":" + str(count) + ",\"jobs\":" + jobs + "}")
      return
    }
    if a[2] == "run" {
      out, err := runJob(db, a[3])
      if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
      println("{\"ok\":true,\"result\":" + out + "}")
      return
    }
    if a[2] == "tick" {
      println("{\"ok\":true,\"fired\":" + str(tickCron(db)) + "}")
      return
    }
    if a[2] == "delete" {
      err := deleteJob(db, a[3])
      if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
      println("{\"ok\":true,\"deleted\":true}")
      return
    }
  }

  if a[1] == "events" {
    if a[2] == "emit" {
      level := ""
      source := ""
      subject := ""
      data := "{}"
      i := 5
      while i < len(a) {
        if a[i] == "--level" { if i+1 < len(a) { level = a[i+1] } }
        if a[i] == "--source" { if i+1 < len(a) { source = a[i+1] } }
        if a[i] == "--subject" { if i+1 < len(a) { subject = a[i+1] } }
        if a[i] == "--data" { if i+1 < len(a) { data = a[i+1] } }
        i = i + 1
      }
      out, err := emitEvent(db, a[3], a[4], level, source, subject, data)
      if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
      println("{\"ok\":true,\"event\":" + out + "}")
      return
    }
    if a[2] == "streams" {
      streams, count := listStreams(db)
      println("{\"ok\":true,\"count\":" + str(count) + ",\"streams\":" + streams + "}")
      return
    }
  }

  if a[1] == "script" {
    if a[2] == "create" {
      source := ""
      description := ""
      timeout := 5000
      allowNet := ""
      runAccess := ""
      i := 4
      while i < len(a) {
        if a[i] == "--file" {
          if i+1 < len(a) {
            if a[i+1] == "-" { source = read_stdin() } else { source = read_file(a[i+1]) }
          }
        }
        if a[i] == "--description" { if i+1 < len(a) { description = a[i+1] } }
        if a[i] == "--timeout" { if i+1 < len(a) { timeout = parse_int(a[i+1]) } }
        if a[i] == "--allow-net" { if i+1 < len(a) { allowNet = a[i+1] } }
        if a[i] == "--run-access" { if i+1 < len(a) { runAccess = a[i+1] } }
        i = i + 1
      }
      out, err := createScript(db, a[3], source, description, timeout, allowNet, runAccess)
      if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
      println("{\"ok\":true,\"script\":" + out + "}")
      return
    }
    if a[2] == "list" {
      scripts, count := listScripts(db)
      println("{\"ok\":true,\"count\":" + str(count) + ",\"scripts\":" + scripts + "}")
      return
    }
    if a[2] == "update" {
      runAccess := ""
      i := 4
      while i < len(a) {
        if a[i] == "--run-access" { if i+1 < len(a) { runAccess = a[i+1] } }
        i = i + 1
      }
      if runAccess == "" { println(cliErr("script update needs --run-access admin|user|public"))  code = 85  return }
      out, err := updateScriptAccess(db, a[3], runAccess)
      if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
      println("{\"ok\":true,\"script\":" + out + "}")
      return
    }
    if a[2] == "delete" {
      err := deleteScript(db, a[3])
      if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
      println("{\"ok\":true,\"deleted\":true}")
      return
    }
  }

  if a[1] == "hooks" {
    if a[2] == "create" {
      script := ""
      maxBytes := 0
      rate := 0
      origins := []string{}
      i := 4
      while i < len(a) {
        if a[i] == "--script" { if i+1 < len(a) { script = a[i+1] } }
        if a[i] == "--max-bytes" { if i+1 < len(a) { maxBytes = parse_int(a[i+1]) } }
        if a[i] == "--rate-limit" { if i+1 < len(a) { rate = parse_int(a[i+1]) } }
        if a[i] == "--allow-origin" { if i+1 < len(a) { origins = append(origins, a[i+1]) } }
        i = i + 1
      }
      out, err := createHook(db, a[3], script, maxBytes, join(origins, ","), rate)
      if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
      println("{\"ok\":true,\"hook\":" + out + "}")
      return
    }
    if a[2] == "list" {
      hooks, count := listHooks(db)
      println("{\"ok\":true,\"count\":" + str(count) + ",\"hooks\":" + hooks + "}")
      return
    }
    if a[2] == "delete" {
      err := deleteHook(db, a[3])
      if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
      println("{\"ok\":true,\"deleted\":true}")
      return
    }
  }

  if a[1] == "lock" {
    if a[2] == "list" {
      println("{\"ok\":true,\"locks\":" + listLocks(db) + "}")
      return
    }
  }

  if a[1] == "kv" {
    if a[2] == "set" {
      kind := "string"
      description := ""
      public := false
      i := 5
      while i < len(a) {
        if a[i] == "--type" { if i+1 < len(a) { kind = a[i+1] } }
        if a[i] == "--description" { if i+1 < len(a) { description = a[i+1] } }
        if a[i] == "--public" { public = true }
        i = i + 1
      }
      out, err := kvSet(db, a[3], a[4], kind, description, public)
      if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
      println("{\"ok\":true,\"entry\":" + out + "}")
      return
    }
    if a[2] == "get" {
      entry, found, err := kvGet(db, a[3])
      if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
      if !found { println("{\"ok\":false,\"error\":{\"message\":\"key not found\"}}")  code = 84  return }
      println("{\"ok\":true,\"entry\":" + entry + "}")
      return
    }
    if a[2] == "list" {
      println("{\"ok\":true,\"entries\":" + kvList(db, "", false) + "}")
      return
    }
  }

  if a[1] == "store" {
    if a[2] == "put" {
      ref := a[3]
      explicit := ""
      data := "{}"
      i := 4
      while i < len(a) {
        if a[i] == "--id" { if i+1 < len(a) { explicit = a[i+1] } }
        if a[i] == "--data" {
          if i+1 < len(a) {
            if a[i+1] == "-" { data = read_stdin() } else { data = a[i+1] }
            if has_prefix(data, "@") { data = read_file(substr(data, 1, len(data))) }
          }
        }
        i = i + 1
      }
      ns, coll, refErr := splitRef(ref)
      if refErr != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(refErr) + "}}")  code = 85  return }
      out, err := putDoc(db, ns, coll, explicit, data)
      if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "}}")  code = 85  return }
      println("{\"ok\":true,\"record\":" + out + "}")
      return
    }
  }

  // --- the read side ------------------------------------------------------
  // The CLI carried only what the acceptance runbook needed, which is the write
  // half. `bkn help-json` exists so an agent can discover the surface, and the
  // read commands exist because "the CLI is the API" is the model this tool
  // claims -- a verb available over HTTP should be a subcommand too.

  if a[1] == "guide" {
    // Embedded, never fetched: the guide travels with the binary, which is the
    // whole point of the convention.
    human := false
    gi := 2
    while gi < len(a) {
      if a[gi] == "--human" { human = true }
      gi = gi + 1
    }
    if human { println(guideMarkdown(db)) } else { println(guideJSON()) }
    return
  }
  if a[1] == "version" {
    println("{\"ok\":true,\"tool\":\"bkn\",\"tool_version\":" + jsonQuote(toolVersion()) + ",\"version\":\"1.0\"}")
    return
  }

  if a[1] == "help-json" {
    println(helpJSON())
    return
  }

  if a[1] == "store" {
    if a[2] == "get" {
      ns, coll, refErr := splitRef(a[3])
      if refErr != "" { println(cliErr(refErr))  code = 85  return }
      rec, found := getDoc(db, ns, coll, a[4])
      if !found { println(cliErr("record not found"))  code = 81  return }
      println("{\"ok\":true,\"record\":" + rec + "}")
      return
    }
    if a[2] == "list" {
      ns, coll, refErr := splitRef(a[3])
      if refErr != "" { println(cliErr(refErr))  code = 85  return }
      limit := 50
      offset := 0
      order := ""
      dir := "asc"
      filters := []Filter{}
      i := 4
      while i < len(a) {
        if a[i] == "--limit" { if i+1 < len(a) { if looksNumeric(a[i+1]) { limit = int(parse(a[i+1], 0)) } } }
        if a[i] == "--offset" { if i+1 < len(a) { if looksNumeric(a[i+1]) { offset = int(parse(a[i+1], 0)) } } }
        if a[i] == "--order-by" {
          if i+1 < len(a) {
            order = a[i+1]
            colon := index(order, ":")
            if colon > 0 {
              dir = substr(order, colon + 1, len(order))
              order = substr(order, 0, colon)
            }
          }
        }
        if a[i] == "--where" { if i+1 < len(a) { filters = appendWhere(db, ns, coll, filters, a[i+1]) } }
        i = i + 1
      }
      // The CLI spells direction the other way round from HTTP: --order-by
      // <field> is ascending and <field>:desc is not.
      desc := dir == "desc"
      records := listJSON(db, ns, coll, filters, order, desc, limit, offset)
      total := countDocs(db, ns, coll, filters)
      println("{\"ok\":true,\"collection\":" + jsonQuote(a[3]) + ",\"count\":" + str(countArray(db, records)) + ",\"total\":" + str(total) + ",\"records\":" + records + "}")
      return
    }
    if a[2] == "find" {
      ns, coll, refErr := splitRef(a[3])
      if refErr != "" { println(cliErr(refErr))  code = 85  return }
      filters := []Filter{}
      i := 4
      while i < len(a) {
        if a[i] == "--where" { if i+1 < len(a) { filters = appendWhere(db, ns, coll, filters, a[i+1]) } }
        i = i + 1
      }
      rec, found := findDoc(db, ns, coll, filters)
      if !found { println(cliErr("record not found"))  code = 81  return }
      println("{\"ok\":true,\"record\":" + rec + "}")
      return
    }
    if a[2] == "collections" {
      nsFilter := ""
      i := 3
      while i < len(a) {
        if a[i] == "--ns" { if i+1 < len(a) { nsFilter = a[i+1] } }
        i = i + 1
      }
      println("{\"ok\":true,\"collections\":" + listCollections(db, nsFilter) + "}")
      return
    }
  }

  if a[1] == "files" {
    if a[2] == "list" {
      body, count := listFiles(db, a[3], 100, 0)
      println("{\"ok\":true,\"count\":" + str(count) + ",\"files\":" + body + "}")
      return
    }
    if a[2] == "show" {
      f, found := findFile(db, a[3], a[4])
      if !found { println(cliErr("file not found"))  code = 81  return }
      println("{\"ok\":true,\"file\":" + fileJSON(f) + "}")
      return
    }
    if a[2] == "put" {
      name := ""
      ctype := ""
      i := 5
      while i < len(a) {
        if a[i] == "--name" { if i+1 < len(a) { name = a[i+1] } }
        if a[i] == "--content-type" { if i+1 < len(a) { ctype = a[i+1] } }
        i = i + 1
      }
      if name == "" { name = baseName(a[4]) }
      // Distinct name: `:=` is function-scoped here, and `body` is already a
      // string elsewhere in runCLI.
      fileBytes := read_file_bytes(a[4])
      out, err, _ := putFile(db, a[3], name, fileBytes, ctype, "{}")
      if err != "" { println(cliErr(err))  code = 85  return }
      println("{\"ok\":true,\"file\":" + out + "}")
      return
    }
    if a[2] == "get" {
      f, found := findFile(db, a[3], a[4])
      if !found { println(cliErr("file not found"))  code = 81  return }
      dest := ""
      i := 5
      while i < len(a) {
        if a[i] == "--out" { if i+1 < len(a) { dest = a[i+1] } }
        i = i + 1
      }
      getBytes := readBlob(f.sha256)
      if dest == "" { dest = f.name }
      write_file_bytes(dest, getBytes)
      println("{\"ok\":true,\"file\":" + fileJSON(f) + ",\"written\":" + jsonQuote(dest) + "}")
      return
    }
  }

  if a[1] == "events" {
    if a[2] == "list" {
      since := ""
      limit := 50
      level := ""
      i := 4
      while i < len(a) {
        if a[i] == "--since" { if i+1 < len(a) { since = a[i+1] } }
        if a[i] == "--level" { if i+1 < len(a) { level = a[i+1] } }
        if a[i] == "--limit" { if i+1 < len(a) { if looksNumeric(a[i+1]) { limit = int(parse(a[i+1], 0)) } } }
        i = i + 1
      }
      body, count, err := listEvents(db, a[3], "", level, "", "", since, "", limit, 0)
      if err != "" { println(cliErr(err))  code = 85  return }
      println("{\"ok\":true,\"count\":" + str(count) + ",\"events\":" + body + "}")
      return
    }
    if a[2] == "stats" {
      by := "type"
      since := ""
      i := 4
      while i < len(a) {
        if a[i] == "--by" { if i+1 < len(a) { by = a[i+1] } }
        if a[i] == "--since" { if i+1 < len(a) { since = a[i+1] } }
        i = i + 1
      }
      body, total, err := eventStats(db, a[3], by, since)
      if err != "" { println(cliErr(err))  code = 85  return }
      println("{\"ok\":true,\"total\":" + str(total) + ",\"stats\":" + body + "}")
      return
    }
  }

  if a[1] == "script" {
    if a[2] == "run" {
      input := "{}"
      i := 4
      while i < len(a) {
        if a[i] == "--input" {
          if i+1 < len(a) {
            if a[i+1] == "-" { input = read_stdin() } else { input = a[i+1] }
            if has_prefix(input, "@") { input = read_file(substr(input, 1, len(input))) }
          }
        }
        i = i + 1
      }
      value, err := runScript(db, a[3], input)
      if err != "" { println("{\"ok\":false,\"error\":{\"message\":" + jsonQuote(err) + "},\"status\":\"error\"}")  code = 85  return }
      println("{\"ok\":true,\"status\":\"ok\",\"value\":" + value + "}")
      return
    }
    if a[2] == "runs" {
      limit := 20
      i := 4
      while i < len(a) {
        if a[i] == "--limit" { if i+1 < len(a) { if looksNumeric(a[i+1]) { limit = int(parse(a[i+1], 0)) } } }
        i = i + 1
      }
      body, count := listRuns(db, a[3], limit)
      println("{\"ok\":true,\"count\":" + str(count) + ",\"runs\":" + body + "}")
      return
    }
  }

  if a[1] == "auth" {
    if a[2] == "user" {
      if a[3] == "list" {
        body, total := listUsers(db, 50, 0)
        println("{\"ok\":true,\"total\":" + str(total) + ",\"users\":" + body + "}")
        return
      }
      if a[3] == "show" {
        u, found := findUser(db, a[4])
        if !found { println(cliErr("user not found"))  code = 81  return }
        println("{\"ok\":true,\"user\":" + userJSON(u) + "}")
        return
      }
    }
    if a[2] == "org" {
      if a[3] == "list" { println("{\"ok\":true,\"orgs\":" + listOrgs(db) + "}")  return }
      if a[3] == "show" {
        o, found := findOrg(db, a[4])
        if !found { println(cliErr("organization not found"))  code = 81  return }
        println("{\"ok\":true,\"org\":{\"id\":" + jsonQuote(o.id) + ",\"slug\":" + jsonQuote(o.slug) + ",\"name\":" + jsonQuote(o.name) + ",\"created_at\":" + jsonQuote(o.created_at) + "}}")
        return
      }
    }
    if a[2] == "member" {
      if a[3] == "list" {
        body, err := listMembers(db, a[4])
        if err != "" { println(cliErr(err))  code = 81  return }
        println("{\"ok\":true,\"members\":" + body + "}")
        return
      }
    }
    if a[2] == "user" {
      if a[3] == "update" {
        name := ""
        role := ""
        password := ""
        disabled := false
        setDisabled := false
        i := 5
        while i < len(a) {
          if a[i] == "--name" { if i+1 < len(a) { name = a[i+1] } }
          if a[i] == "--role" { if i+1 < len(a) { role = a[i+1] } }
          if a[i] == "--password" { if i+1 < len(a) { password = a[i+1] } }
          if a[i] == "--password-stdin" { password = trim(read_stdin()) }
          if a[i] == "--enable" { disabled = false  setDisabled = true }
          if a[i] == "--disable" { disabled = true  setDisabled = true }
          i = i + 1
        }
        if name == "" && role == "" && password == "" && !setDisabled {
          println(cliErr("pass at least one of --name, --role, --password[-stdin], --enable or --disable"))
          code = 85
          return
        }
        updated, uErr, revoked := updateUser(db, a[4], name, role, password, disabled, setDisabled)
        if uErr != "" { println(cliErr(uErr))  code = 85  return }
        rv := "false"
        if revoked { rv = "true" }
        println("{\"ok\":true,\"user\":" + userJSON(updated) + ",\"sessions_revoked\":" + rv + "}")
        return
      }
      if a[3] == "delete" {
        if !deleteUser(db, a[4]) { println(cliErr("user not found"))  code = 81  return }
        println("{\"ok\":true,\"deleted\":true}")
        return
      }
    }
    if a[2] == "org" {
      if a[3] == "delete" {
        if !deleteOrg(db, a[4]) { println(cliErr("organization not found"))  code = 81  return }
        println("{\"ok\":true,\"deleted\":true}")
        return
      }
    }
    if a[2] == "member" {
      if a[3] == "remove" {
        ok, err := removeMember(db, a[4], a[5])
        if err != "" { println(cliErr(err))  code = 81  return }
        if !ok { println(cliErr("membership not found"))  code = 81  return }
        println("{\"ok\":true,\"removed\":true}")
        return
      }
    }
    // --- sessions ---------------------------------------------------------
    // These take a token as an ARGUMENT rather than reading BKN_ADMIN_TOKEN:
    // they act as the holder of that token, not as the operator, so which
    // token is in play must be explicit.
    if a[2] == "login" {
      password := ""
      org := ""
      i := 4
      while i < len(a) {
        if a[i] == "--password-stdin" { password = trim(read_stdin()) }
        if a[i] == "--password" { if i+1 < len(a) { password = a[i+1] } }
        if a[i] == "--org" { if i+1 < len(a) { org = a[i+1] } }
        i = i + 1
      }
      tokens, err := login(db, a[3], password, org)
      if err != "" { println(cliErr(err))  code = 85  return }
      println("{\"ok\":true,\"tokens\":" + tokens + "}")
      return
    }
    if a[2] == "refresh" {
      // useSessionOrg: a plain refresh keeps the org the session already had,
      // so refreshing never silently changes which tenant you are in.
      tokens, err := refreshTokens(db, a[3], "", true)
      if err != "" { println(cliErr(err))  code = 85  return }
      println("{\"ok\":true,\"tokens\":" + tokens + "}")
      return
    }
    if a[2] == "switch-org" {
      tokens, err := refreshTokens(db, a[3], a[4], false)
      if err != "" { println(cliErr(err))  code = 85  return }
      println("{\"ok\":true,\"tokens\":" + tokens + "}")
      return
    }
    if a[2] == "logout" {
      // Revoking an unknown or already-dead token is a success: the caller's
      // goal is that it stops working, and it has.
      logout(db, a[3])
      println("{\"ok\":true,\"logged_out\":true}")
      return
    }
    if a[2] == "me" {
      user, claims, err := meFromToken(db, a[3])
      if err != "" { println(cliErr(err))  code = 85  return }
      println("{\"ok\":true,\"user\":" + user + ",\"org\":" + jsonQuote(jsonField(claims, ".org")) + "}")
      return
    }
    if a[2] == "sessions" {
      body, count, err := sessionsOf(db, a[3])
      if err != "" { println(cliErr(err))  code = 81  return }
      println("{\"ok\":true,\"count\":" + str(count) + ",\"sessions\":" + body + "}")
      return
    }
    if a[2] == "revoke" {
      n, err := revokeUserSessions(db, a[3])
      if err != "" { println(cliErr(err))  code = 81  return }
      println("{\"ok\":true,\"revoked\":" + str(n) + "}")
      return
    }
    if a[2] == "memberships" {
      u, found := findUser(db, a[3])
      if !found { println(cliErr("user not found"))  code = 81  return }
      body, count := membershipsOf(db, u.id)
      println("{\"ok\":true,\"count\":" + str(count) + ",\"memberships\":" + body + "}")
      return
    }
    if a[2] == "can" {
      u, uFound := findUser(db, a[3])
      if !uFound { println(cliErr("user not found"))  code = 81  return }
      o, oFound := findOrg(db, a[4])
      if !oFound { println(cliErr("organization not found"))  code = 81  return }
      have, haveFound := membershipRole(db, o.id, u.id)
      allowed := false
      if haveFound { allowed = roleAtLeast(have, a[5]) }
      if allowed { println("{\"ok\":true,\"allowed\":true}")  return }
      println("{\"ok\":true,\"allowed\":false}")
      return
    }
  }

  if a[1] == "store" {
    if a[2] == "create" {
      ns, coll, refErr := splitRef(a[3])
      if refErr != "" { println(cliErr(refErr))  code = 85  return }
      rules := []string{}
      i := 4
      while i < len(a) {
        if a[i] == "--normalize" {
          if i+1 < len(a) {
            pair := a[i+1]
            eq := index(pair, "=")
            if eq > 0 {
              rules = append(rules, jsonQuote(substr(pair, 0, eq)) + ":" + jsonQuote(substr(pair, eq+1, len(pair))))
            }
          }
        }
        i = i + 1
      }
      ensureCollection(db, ns, coll)
      if len(rules) > 0 { setNormalizers(db, ns, coll, "{" + join(rules, ",") + "}") }
      println("{\"ok\":true,\"collection\":{\"ref\":" + jsonQuote(ns + "/" + coll) + ",\"normalize\":" + normalizersOf(db, ns, coll) + "}}")
      return
    }
    if a[2] == "delete" {
      ns, coll, refErr := splitRef(a[3])
      if refErr != "" { println(cliErr(refErr))  code = 85  return }
      if !deleteDoc(db, ns, coll, a[4]) { println(cliErr("record not found"))  code = 81  return }
      println("{\"ok\":true,\"deleted\":true}")
      return
    }
    if a[2] == "patch" {
      ns, coll, refErr := splitRef(a[3])
      if refErr != "" { println(cliErr(refErr))  code = 85  return }
      patch := ""
      i := 5
      while i < len(a) {
        if a[i] == "--data" {
          if i+1 < len(a) {
            if a[i+1] == "-" { patch = read_stdin() } else { patch = dataArg(a[i+1]) }
          }
        }
        i = i + 1
      }
      if patch == "" { println(cliErr("patch needs --data <json|@file|->"))  code = 85  return }
      rec, found, pErr, _ := patchDocIf(db, ns, coll, a[4], patch, "", "")
      if pErr != "" { println(cliErr(pErr))  code = 85  return }
      if !found { println(cliErr("record not found"))  code = 81  return }
      println("{\"ok\":true,\"record\":" + rec + "}")
      return
    }
  }

  if a[1] == "kv" {
    if a[2] == "delete" {
      if !kvDelete(db, a[3]) { println(cliErr("key not found"))  code = 81  return }
      println("{\"ok\":true,\"deleted\":true}")
      return
    }
    if a[2] == "rekey" {
      rekeyed, skipped, failed, rErr := kvRekey(db)
      body := "{\"ok\":true,\"rekeyed\":" + str(rekeyed) + ",\"skipped\":" + str(skipped) + ",\"failed\":" + str(failed) + ",\"key_id\":" + jsonQuote(activeKeyID()) + "}"
      if rErr != "" {
        println("{\"ok\":false,\"rekeyed\":" + str(rekeyed) + ",\"skipped\":" + str(skipped) + ",\"failed\":" + str(failed) + ",\"error\":{\"message\":" + jsonQuote(rErr) + "}}")
        code = 85
        return
      }
      println(body)
      return
    }
  }

  if a[1] == "events" {
    if a[2] == "prune" {
      olderThan := ""
      stream := ""
      i := 3
      while i < len(a) {
        if a[i] == "--older-than" { if i+1 < len(a) { olderThan = a[i+1] } }
        if a[i] == "--stream" { if i+1 < len(a) { stream = a[i+1] } }
        i = i + 1
      }
      removed, pErr := pruneEvents(db, olderThan, stream)
      if pErr != "" { println(cliErr(pErr))  code = 85  return }
      println("{\"ok\":true,\"removed\":" + str(removed) + "}")
      return
    }
  }

  if a[1] == "files" {
    if a[2] == "delete" {
      dErr := deleteFile(db, a[3], a[4])
      if dErr != "" { println(cliErr(dErr))  code = 81  return }
      println("{\"ok\":true,\"deleted\":true}")
      return
    }
  }

  if a[1] == "lock" {
    if a[2] == "acquire" {
      ttl := 60
      i := 4
      while i < len(a) {
        if a[i] == "--ttl" { if i+1 < len(a) { ttl = parseAge(a[i+1]) } }
        i = i + 1
      }
      owner, ok := acquireLock(db, a[3], ttl)
      // Held by someone else is an ordinary answer, not an error: the caller
      // asked whether it could have the lock and the answer is no.
      if !ok { println("{\"ok\":true,\"acquired\":false}")  return }
      println("{\"ok\":true,\"acquired\":true,\"owner\":" + jsonQuote(owner) + ",\"ttl\":" + str(ttl) + "}")
      return
    }
    if a[2] == "release" {
      force := false
      i := 4
      while i < len(a) {
        if a[i] == "--force" { force = true }
        i = i + 1
      }
      owner := ""
      if len(a) > 4 { if !has_prefix(a[4], "--") { owner = a[4] } }
      if force {
        // --force exists for the case the owner token was lost. It is the
        // only way to break a live lease, so it must be asked for explicitly.
        if !forceReleaseLock(db, a[3]) { println(cliErr("lock not found"))  code = 81  return }
        println("{\"ok\":true,\"released\":true,\"forced\":true}")
        return
      }
      if owner == "" { println(cliErr("release needs the owner token, or --force"))  code = 85  return }
      if !releaseLock(db, a[3], owner) { println(cliErr("lock not found, or the owner token does not match"))  code = 81  return }
      println("{\"ok\":true,\"released\":true}")
      return
    }
  }

  if a[1] == "cron" {
    if a[2] == "show" {
      j, found := findJob(db, a[3])
      if !found { println(cliErr("job not found"))  code = 81  return }
      println("{\"ok\":true,\"job\":" + jobJSON(j) + "}")
      return
    }
    if a[2] == "update" {
      schedule := ""
      script := ""
      input := ""
      enabled := false
      setEnabled := false
      i := 4
      while i < len(a) {
        if a[i] == "--schedule" { if i+1 < len(a) { schedule = a[i+1] } }
        if a[i] == "--script" { if i+1 < len(a) { script = a[i+1] } }
        if a[i] == "--input" { if i+1 < len(a) { input = dataArg(a[i+1]) } }
        if a[i] == "--enable" { enabled = true  setEnabled = true }
        if a[i] == "--disable" { enabled = false  setEnabled = true }
        i = i + 1
      }
      if schedule == "" && script == "" && input == "" && !setEnabled {
        println(cliErr("pass at least one of --schedule, --script, --input, --enable or --disable"))
        code = 85
        return
      }
      out, uErr := updateJob(db, a[3], schedule, script, input, enabled, setEnabled)
      if uErr != "" { println(cliErr(uErr))  code = 85  return }
      println("{\"ok\":true,\"job\":" + out + "}")
      return
    }
  }

  if a[1] == "hooks" {
    if a[2] == "show" {
      h, found := findHook(db, a[3])
      if !found { println(cliErr("hook not found"))  code = 81  return }
      println("{\"ok\":true,\"hook\":" + hookJSON(h) + "}")
      return
    }
    if a[2] == "update" {
      script := ""
      origin := ""
      setOrigin := false
      // -1 means "leave alone": zero is a real value for both of these
      // (no cap, no limit), so it cannot double as absent.
      maxBytes := 0 - 1
      rateLimit := 0 - 1
      enabled := false
      setEnabled := false
      i := 4
      while i < len(a) {
        if a[i] == "--script" { if i+1 < len(a) { script = a[i+1] } }
        if a[i] == "--max-bytes" { if i+1 < len(a) { maxBytes = parse_int(a[i+1]) } }
        if a[i] == "--rate-limit" { if i+1 < len(a) { rateLimit = parse_int(a[i+1]) } }
        if a[i] == "--allow-origin" { if i+1 < len(a) { origin = a[i+1]  setOrigin = true } }
        if a[i] == "--enable" { enabled = true  setEnabled = true }
        if a[i] == "--disable" { enabled = false  setEnabled = true }
        i = i + 1
      }
      if script == "" && maxBytes < 0 && rateLimit < 0 && !setOrigin && !setEnabled {
        println(cliErr("pass at least one of --script, --max-bytes, --rate-limit, --allow-origin, --enable or --disable"))
        code = 85
        return
      }
      out, uErr := updateHook(db, a[3], script, maxBytes, origin, rateLimit, enabled, setEnabled, setOrigin)
      if uErr != "" { println(cliErr(uErr))  code = 85  return }
      println("{\"ok\":true,\"hook\":" + out + "}")
      return
    }
    if a[2] == "test" {
      h, found := findHook(db, a[3])
      if !found { println(cliErr("hook not found"))  code = 81  return }
      body := ""
      method := "POST"
      headers := []string{}
      i := 4
      while i < len(a) {
        if a[i] == "--body" {
          if i+1 < len(a) {
            if a[i+1] == "-" { body = read_stdin() } else { body = dataArg(a[i+1]) }
          }
        }
        if a[i] == "--method" { if i+1 < len(a) { method = a[i+1] } }
        if a[i] == "--header" {
          if i+1 < len(a) {
            pair := a[i+1]
            eq := index(pair, "=")
            if eq > 0 {
              headers = append(headers, jsonQuote(to_lower(substr(pair, 0, eq))) + ":" + jsonQuote(substr(pair, eq+1, len(pair))))
            }
          }
        }
        i = i + 1
      }
      s2, scriptFound := findScript(db, h.script)
      if !scriptFound { println(cliErr("the hook names a script that does not exist: " + h.script))  code = 81  return }
      // Deliberately runs the script WITHOUT the hook's rate limit, body cap
      // or CORS: those are properties of the public door, and a test is not
      // coming through it. The envelope is the real one.
      d := hookEnvelope(method, "/v1/hooks/" + h.name, "{}", "{" + join(headers, ",") + "}", body, "127.0.0.1")
      value, rErr := runSource(db, s2.source, d, s2.timeout_ms, s2.allow_net, anonCaller())
      if rErr != "" {
        println("{\"ok\":false,\"status\":\"error\",\"error\":" + jsonQuote(rErr) + ",\"value\":null}")
        code = 85
        return
      }
      println("{\"ok\":true,\"status\":\"ok\",\"value\":" + value + "}")
      return
    }
  }

  if a[1] == "script" {
    if a[2] == "show" {
      sc, found := findScript(db, a[3])
      if !found { println(cliErr("script not found"))  code = 81  return }
      println("{\"ok\":true,\"script\":" + scriptJSON(sc) + "}")
      return
    }
    if a[2] == "test" {
      source := ""
      input := "{}"
      timeout := 5000
      allowNet := ""
      i := 3
      while i < len(a) {
        if a[i] == "--file" {
          if i+1 < len(a) {
            if a[i+1] == "-" { source = read_stdin() } else { source = read_file(a[i+1]) }
          }
        }
        if a[i] == "--input" { if i+1 < len(a) { input = dataArg(a[i+1]) } }
        if a[i] == "--timeout" { if i+1 < len(a) { timeout = parse_int(a[i+1]) } }
        if a[i] == "--allow-net" { if i+1 < len(a) { allowNet = a[i+1] } }
        i = i + 1
      }
      if source == "" { println(cliErr("script test needs --file <path|->"))  code = 85  return }
      value, rErr := runSource(db, source, input, timeout, allowNet, anonCaller())
      if rErr != "" {
        println("{\"ok\":false,\"status\":\"error\",\"error\":" + jsonQuote(rErr) + ",\"value\":null}")
        code = 85
        return
      }
      println("{\"ok\":true,\"status\":\"ok\",\"value\":" + value + "}")
      return
    }
  }

  println("{\"ok\":false,\"error\":{\"message\":\"unknown command\"}}")
  code = 80
}

// `--data`/`--input` take raw JSON or @file; `-` for stdin is handled at the
// call site, because only some flags accept it.
func dataArg(v) (out) {
  out = v
  if has_prefix(v, "@") { out = read_file(substr(v, 1, len(v))) }
}

func cliErr(msg) (s) { s = "{\"ok\":false,\"error\":{\"message\":" + jsonQuote(msg) + "}}" }

func baseName(p) (n) {
  n = p
  i := len(p) - 1
  while i >= 0 {
    if substr(p, i, i+1) == "/" { n = substr(p, i+1, len(p))  return }
    i = i - 1
  }
}

// appendWhere parses one --where predicate into a Filter. The CLI spells them
// field=value, field>value, field:in=a,b -- the same six operators the HTTP
// query string uses, written the way a shell can pass without quoting games.
// Values are passed through raw: whereClause applies the collection's
// normalizers to filter values itself, so doing it here too would fold twice.
func appendWhere(db, ns, coll, filters, expr) (out) {
  out = filters
  field := ""
  op := "eq"
  value := ""
  colon := index(expr, ":in=")
  if colon > 0 {
    field = substr(expr, 0, colon)
    op = "in"
    value = substr(expr, colon + 4, len(expr))
    out = append(out, Filter{field: field, op: op, value: value})
    return
  }
  i := 0
  while i < len(expr) {
    c := substr(expr, i, i+1)
    if c == "=" {
      field = substr(expr, 0, i)
      value = substr(expr, i+1, len(expr))
      if len(field) > 0 {
        last := substr(field, len(field)-1, len(field))
        if last == "!" { op = "ne"  field = substr(field, 0, len(field)-1) }
        if last == ">" { op = "gte" field = substr(field, 0, len(field)-1) }
        if last == "<" { op = "lte" field = substr(field, 0, len(field)-1) }
      }
      out = append(out, Filter{field: field, op: op, value: value})
      return
    }
    if c == ">" { field = substr(expr, 0, i)  op = "gt"  value = substr(expr, i+1, len(expr))
      out = append(out, Filter{field: field, op: op, value: value})  return }
    if c == "<" { field = substr(expr, 0, i)  op = "lt"  value = substr(expr, i+1, len(expr))
      out = append(out, Filter{field: field, op: op, value: value})  return }
    i = i + 1
  }
}

// helpJSON is the machine-readable catalogue the agent-first contract asks for:
// an agent discovers the surface here rather than by parsing help text.
func helpJSON() (s) {
  cmds := []string{}
  cmds = append(cmds, "\"store put\":{\"args\":[\"ns/coll\"],\"flags\":[\"--id <id>\",\"--data <json|@file|->\"]}")
  cmds = append(cmds, "\"store get\":{\"args\":[\"ns/coll\",\"id\"],\"flags\":[]}")
  cmds = append(cmds, "\"store list\":{\"args\":[\"ns/coll\"],\"flags\":[\"--where <predicate>\",\"--order-by <field[:desc]>\",\"--limit <n>\",\"--offset <n>\"]}")
  cmds = append(cmds, "\"store find\":{\"args\":[\"ns/coll\"],\"flags\":[\"--where <predicate>\"]}")
  cmds = append(cmds, "\"store create\":{\"args\":[\"ns/coll\"],\"flags\":[\"--normalize <field=rule>\"]}")
  cmds = append(cmds, "\"store patch\":{\"args\":[\"ns/coll\",\"id\"],\"flags\":[\"--data <json|@file|->\"]}")
  cmds = append(cmds, "\"store delete\":{\"args\":[\"ns/coll\",\"id\"],\"flags\":[]}")
  cmds = append(cmds, "\"store collections\":{\"args\":[],\"flags\":[\"--ns <namespace>\"]}")
  cmds = append(cmds, "\"kv get\":{\"args\":[\"key\"],\"flags\":[]}")
  cmds = append(cmds, "\"kv set\":{\"args\":[\"key\",\"value\"],\"flags\":[\"--type <string|json|encrypted>\",\"--public\"]}")
  cmds = append(cmds, "\"kv delete\":{\"args\":[\"key\"],\"flags\":[]}")
  cmds = append(cmds, "\"kv rekey\":{\"args\":[],\"flags\":[]}")
  cmds = append(cmds, "\"kv list\":{\"args\":[],\"flags\":[\"--prefix <p>\"]}")
  cmds = append(cmds, "\"auth user create\":{\"args\":[\"email\"],\"flags\":[\"--password-stdin\",\"--password <p>\",\"--name <n>\",\"--role <user|admin>\"]}")
  cmds = append(cmds, "\"auth user list\":{\"args\":[],\"flags\":[]}")
  cmds = append(cmds, "\"auth user show\":{\"args\":[\"email|id\"],\"flags\":[]}")
  cmds = append(cmds, "\"auth user update\":{\"args\":[\"email|id\"],\"flags\":[\"--name <n>\",\"--role <r>\",\"--password <p>\",\"--password-stdin\",\"--enable\",\"--disable\"]}")
  cmds = append(cmds, "\"auth user delete\":{\"args\":[\"email|id\"],\"flags\":[]}")
  cmds = append(cmds, "\"auth login\":{\"args\":[\"email\"],\"flags\":[\"--password <p>\",\"--password-stdin\",\"--org <slug>\"]}")
  cmds = append(cmds, "\"auth logout\":{\"args\":[\"refresh-token\"],\"flags\":[]}")
  cmds = append(cmds, "\"auth me\":{\"args\":[\"access-token\"],\"flags\":[]}")
  cmds = append(cmds, "\"auth refresh\":{\"args\":[\"refresh-token\"],\"flags\":[]}")
  cmds = append(cmds, "\"auth switch-org\":{\"args\":[\"refresh-token\",\"org\"],\"flags\":[]}")
  cmds = append(cmds, "\"auth sessions\":{\"args\":[\"user\"],\"flags\":[]}")
  cmds = append(cmds, "\"auth revoke\":{\"args\":[\"user\"],\"flags\":[]}")
  cmds = append(cmds, "\"auth org create\":{\"args\":[\"slug\"],\"flags\":[\"--name <n>\"]}")
  cmds = append(cmds, "\"auth org delete\":{\"args\":[\"slug|id\"],\"flags\":[]}")
  cmds = append(cmds, "\"auth org list\":{\"args\":[],\"flags\":[]}")
  cmds = append(cmds, "\"auth org show\":{\"args\":[\"slug|id\"],\"flags\":[]}")
  cmds = append(cmds, "\"auth member add\":{\"args\":[\"org\",\"user\"],\"flags\":[\"--role <owner|admin|member>\"]}")
  cmds = append(cmds, "\"auth member remove\":{\"args\":[\"org\",\"user\"],\"flags\":[]}")
  cmds = append(cmds, "\"auth member list\":{\"args\":[\"org\"],\"flags\":[]}")
  cmds = append(cmds, "\"auth memberships\":{\"args\":[\"user\"],\"flags\":[]}")
  cmds = append(cmds, "\"auth can\":{\"args\":[\"user\",\"org\",\"min-role\"],\"flags\":[]}")
  cmds = append(cmds, "\"files ns create\":{\"args\":[\"name\"],\"flags\":[\"--allow-type <t>\",\"--public\"]}")
