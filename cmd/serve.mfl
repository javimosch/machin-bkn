
var gDB = 0
var gAdmin = ""
var gHost = "127.0.0.1"
var gScheduler = 0

func storeRoutes(req, q, segs, dec) (res, handled) {
  handled = true
  ns := segs[2]
  coll := segs[3]
  ref := ns + "/" + coll
  _, _, refErr := splitRef(ref)
  if refErr != "" { res = errRes("400 Bad Request", "invalid_arguments", refErr)  return }

  if len(segs) == 4 {
    if req.method == "GET" {
      // A rollup answers how many, not which — so it short-circuits the record
      // listing entirely rather than decorating it.
      by := qGet(q, "by")
      if by != "" {
        body, rstatus := rollupJSON(gDB, ns, coll, scopedFilters(filtersFrom(q), dec), by, qInt(q, "by_limit", 0))
        if rstatus == 400 { res = errRes("400 Bad Request", "validation_error", "cannot group by " + by)  handled = true  return }
        res = jsonRes("200 OK", body)
        handled = true
        return
      }
      filters := scopedFilters(filtersFrom(q), dec)
      limit := qInt(q, "limit", 50)
      offset := qInt(q, "offset", 0)
      orderBy := qGet(q, "order_by")
      // Over HTTP the direction defaults to descending; only an explicit
      // order=asc reverses it. (The CLI spells this the other way round:
      // --order-by <field> is ascending and <field>:desc is not.)
      desc := true
      if qGet(q, "order") == "asc" { desc = false }

      records := listJSON(gDB, ns, coll, filters, orderBy, desc, limit, offset)
      total := countDocs(gDB, ns, coll, filters)
      count := countArray(gDB, records)
      res = jsonRes("200 OK", "{\"ok\":true,\"collection\":" + jsonQuote(ref) + ",\"count\":" + str(count) + ",\"total\":" + str(total) + ",\"records\":" + records + "}")
      return
    }
    // PUT declares the collection itself — normalizers and, now, its access
    // policy. Declaring over HTTP is how a deployment behind a reverse proxy
    // gets a policy at all.
    if req.method == "PUT" {
      acc := jsonField(req.body, ".access")
      if acc != "" {
        aerr := validateAccess(gDB, acc)
        if aerr != "" { res = errRes("400 Bad Request", "validation_error", aerr)  return }
        setAccess(gDB, ns, coll, acc)
      }
      norm := jsonField(req.body, ".normalize")
      if norm != "" { setNormalizers(gDB, ns, coll, norm) }
      ensureCollection(gDB, ns, coll)
      res = jsonRes("200 OK", "{\"ok\":true,\"collection\":{\"ns\":" + jsonQuote(ns) + ",\"name\":" + jsonQuote(coll) + ",\"access\":" + accessOf(gDB, ns, coll) + ",\"normalize\":" + normalizersOf(gDB, ns, coll) + "}}")
      return
    }
    if req.method == "POST" {
      // A create stamps the caller's own scope, so a body claiming somebody
      // else's owner id cannot take effect — and an upsert at a stranger's id
      // is a 404, not a silent takeover.
      body := req.body
      if dec.scopeField != "" {
        if qGet(q, "id") != "" {
          existing, had := getDoc(gDB, ns, coll, qGet(q, "id"))
          if had {
            if jsonField(existing, "." + dec.scopeField) != dec.scopeValue {
              res = errRes("404 Not Found", "not_found", "record not found")
              return
            }
          }
        }
        stamped := sqlite_query(gDB, "SELECT json_set(?, ?, ?) AS d", []string{body, "$." + dec.scopeField, dec.scopeValue})
        if stamped != "[]" { body = jsonString(stamped, "[0].d", body) }
      }
      record, err := putDoc(gDB, ns, coll, qGet(q, "id"), body)
      if err != "" { res = errRes("400 Bad Request", "validation_error", err)  return }
      res = jsonRes("200 OK", "{\"ok\":true,\"record\":" + record + "}")
      return
    }
    res = errRes("405 Method Not Allowed", "method_not_allowed", "unsupported method " + req.method)
    return
  }

  id := segs[4]
  // Scope is part of the lookup, not a check beside it: a document that is
  // not yours was never in the result set, so it answers 404 rather than
  // 403. A 403 would confirm it exists.
  if dec.scopeField != "" {
    owned, ownedFound := getDoc(gDB, ns, coll, id)
    if !ownedFound { res = errRes("404 Not Found", "not_found", "record not found")  return }
    if jsonField(owned, "." + dec.scopeField) != dec.scopeValue {
      res = errRes("404 Not Found", "not_found", "record not found")
      return
    }
  }
  if req.method == "GET" {
    record, found := getDoc(gDB, ns, coll, id)
    if !found { res = errRes("404 Not Found", "not_found", "record not found")  return }
    res = jsonRes("200 OK", "{\"ok\":true,\"record\":" + record + "}")
    return
  }
  if req.method == "PATCH" {
    // Update must not mean "give away": a patch that rewrites the scope field
    // to somebody else is refused outright rather than silently applied.
    if refusesHandover(req.body, dec) {
      res = errRes("403 Forbidden", "forbidden", "you cannot move this record out of your own scope")
      return
    }
    record, found, err, status := patchDocIf(gDB, ns, coll, id, req.body, qGet(q, "if"), qGet(q, "if-absent"))
    if status == 409 { res = errRes("409 Conflict", "precondition_failed", err)  return }
    if err != "" { res = errRes("400 Bad Request", "validation_error", err)  return }
    if !found { res = errRes("404 Not Found", "not_found", "record not found")  return }
    res = jsonRes("200 OK", "{\"ok\":true,\"record\":" + record + "}")
    return
  }
  if req.method == "DELETE" {
    if !deleteDoc(gDB, ns, coll, id) { res = errRes("404 Not Found", "not_found", "record not found")  return }
    res = jsonRes("200 OK", "{\"ok\":true,\"deleted\":" + jsonQuote(id) + ",\"collection\":" + jsonQuote(ref) + "}")
    return
  }
  res = errRes("405 Method Not Allowed", "method_not_allowed", "unsupported method " + req.method)
}

// authStatus maps an error message to the status and stable type the
// contract's callers branch on.
func authStatus(err) (status, kind) {
  status = "500 Internal Server Error"
  kind = "internal_error"
  if err == "email or password is incorrect" { status = "401 Unauthorized"  kind = "bad_credentials" }
  if err == "user is disabled" { status = "403 Forbidden"  kind = "user_disabled" }
  if err == "refresh token is unknown, revoked or expired" { status = "401 Unauthorized"  kind = "session_invalid" }
  if err == "organization not found" { status = "404 Not Found"  kind = "not_found" }
  if err == "user not found" { status = "404 Not Found"  kind = "not_found" }
  if err == "user is not a member of that organization" { status = "403 Forbidden"  kind = "not_a_member" }
  if err == "token has expired" { status = "401 Unauthorized"  kind = "token_expired" }
  if err == "token is malformed or its signature does not match" { status = "401 Unauthorized"  kind = "bad_token" }
}

func authRoutes(req, q, segs) (res) {
  leaf := segs[2]

  if leaf == "login" {
    tokens, err := login(gDB, jsonField(req.body, ".email"), jsonField(req.body, ".password"), jsonField(req.body, ".org"))
    if err != "" {
      st, kind := authStatus(err)
      res = errRes(st, kind, err)
      return
    }
    res = jsonRes("200 OK", "{\"ok\":true,\"tokens\":" + tokens + "}")
    return
  }

  if leaf == "refresh" {
    tokens, err := refreshTokens(gDB, jsonField(req.body, ".refresh_token"), "", true)
    if err != "" {
      st, kind := authStatus(err)
      res = errRes(st, kind, err)
      return
    }
    res = jsonRes("200 OK", "{\"ok\":true,\"tokens\":" + tokens + "}")
    return
  }

  if leaf == "switch-org" {
    tokens, err := refreshTokens(gDB, jsonField(req.body, ".refresh_token"), jsonField(req.body, ".org"), false)
    if err != "" {
      st, kind := authStatus(err)
      res = errRes(st, kind, err)
      return
    }
    res = jsonRes("200 OK", "{\"ok\":true,\"tokens\":" + tokens + "}")
    return
  }

  if leaf == "logout" {
    logout(gDB, jsonField(req.body, ".refresh_token"))
    res = jsonRes("200 OK", "{\"ok\":true,\"logged_out\":true}")
    return
  }

  if leaf == "me" {
    token := bearer(req)
    if token == "" { res = errRes("401 Unauthorized", "not_authenticated", "missing bearer access token")  return }
    user, claims, err := meFromToken(gDB, token)
    if err != "" {
      st, kind := authStatus(err)
      res = errRes(st, kind, err)
      return
    }
    memberships, count := membershipsOf(gDB, jsonField(user, ".id"))
    _ = count
    res = jsonRes("200 OK", "{\"ok\":true,\"user\":" + user + ",\"claims\":" + claims + ",\"memberships\":" + memberships + "}")
    return
  }

  // Self-service: a signed-in user changes their OWN password by proving the
  // current one. An anonymous caller gets 401 rather than 403 — a credential
  // would genuinely help here.
  if leaf == "password" {
    if req.method != "POST" { res = errRes("405 Method Not Allowed", "method_not_allowed", "use POST")  return }
    tok := bearer(req)
    if tok == "" { res = errRes("401 Unauthorized", "not_authenticated", "missing bearer access token")  return }
    // meFromToken hands back the user as JSON, so resolve the row to reach the
    // stored hash — the current password has to be proved, not just claimed.
    whoJSON, _, merr := meFromToken(gDB, tok)
    if merr != "" { res = errRes("401 Unauthorized", "not_authenticated", merr)  return }
    who, whoFound := findUser(gDB, jsonField(whoJSON, ".id"))
    if !whoFound { res = errRes("401 Unauthorized", "not_authenticated", "user not found")  return }
    cur := jsonField(req.body, ".current_password")
    nxt := jsonField(req.body, ".new_password")
    if nxt == "" { res = errRes("400 Bad Request", "validation_error", "new_password is required")  return }
    if !verifyPassword(cur, who.password_hash) {
      res = errRes("401 Unauthorized", "bad_credentials", "email or password is incorrect")
      return
    }
    _, uerr, _ := updateUser(gDB, who.id, "", "", nxt, false, false)
    if uerr != "" { res = errRes("400 Bad Request", "validation_error", uerr)  return }
    res = jsonRes("200 OK", "{\"ok\":true,\"changed\":true}")
    return
  }

  // Administering identities is operator work, not user work.
  if !authed(req, gAdmin, gHost) {
    res = errRes("403 Forbidden", "not_authenticated", "missing or invalid bearer token")
    return
  }
  if leaf == "users" {
    if req.method == "POST" && len(segs) == 3 {
      created, err := createUser(gDB, jsonField(req.body, ".email"), jsonField(req.body, ".password"), jsonField(req.body, ".name"), jsonField(req.body, ".role"))
      if err != "" {
        st, kind := authStatus(err)
        res = errRes(st, kind, err)
        return
      }
      res = jsonRes("201 Created", "{\"ok\":true,\"user\":" + created + "}")
      return
    }
    // PATCH /v1/auth/users/<id-or-email> — the operator's reset. An account
    // whose password an admin has changed must not keep answering to the old
    // one anywhere, so the revocation is part of the same call and is reported.
    if req.method == "PATCH" && len(segs) == 4 {
      nm := jsonField(req.body, ".name")
      rl := jsonField(req.body, ".role")
      pw := jsonField(req.body, ".password")
      dz, dzErr := json_get(req.body, ".disabled")
      setDis := dzErr == ""
      dis := dz == "true"
      if nm == "" && rl == "" && pw == "" && !setDis {
        res = errRes("400 Bad Request", "validation_error", "pass at least one of name, role, password or disabled")
        return
      }
      updated, uErr, revoked := updateUser(gDB, segs[3], nm, rl, pw, dis, setDis)
      if uErr != "" {
        st, kind := authStatus(uErr)
        res = errRes(st, kind, uErr)
        return
      }
      rv := "false"
      if revoked { rv = "true" }
      res = jsonRes("200 OK", "{\"ok\":true,\"user\":" + userJSON(updated) + ",\"sessions_revoked\":" + rv + "}")
      return
    }
    users, count := listUsers(gDB, qInt(q, "limit", 50), qInt(q, "offset", 0))
    res = jsonRes("200 OK", "{\"ok\":true,\"count\":" + str(count) + ",\"users\":" + users + "}")
    return
  }
  if leaf == "orgs" {
    // /v1/auth/orgs/<slug>/members — membership is addressed under its org
    // rather than as a top-level resource, because it has no meaning without one.
    if len(segs) >= 5 {
      if segs[4] == "members" {
        if req.method == "POST" {
          merr := addMember(gDB, segs[3], jsonField(req.body, ".user"), jsonField(req.body, ".role"))
          if merr != "" {
            st, kind := authStatus(merr)
            res = errRes(st, kind, merr)
            return
          }
          res = jsonRes("201 Created", "{\"ok\":true,\"added\":true}")
          return
        }
        members, lerr := listMembers(gDB, segs[3])
        if lerr != "" { res = errRes("404 Not Found", "not_found", lerr)  return }
        res = jsonRes("200 OK", "{\"ok\":true,\"members\":" + members + "}")
        return
      }
    }
    if req.method == "POST" && len(segs) == 3 {
      org, oerr := createOrg(gDB, jsonField(req.body, ".slug"), jsonField(req.body, ".name"))
      if oerr != "" {
        st, kind := authStatus(oerr)
        res = errRes(st, kind, oerr)
        return
      }
      res = jsonRes("201 Created", "{\"ok\":true,\"org\":" + org + "}")
      return
    }
    orgs := listOrgs(gDB)
    res = jsonRes("200 OK", "{\"ok\":true,\"count\":" + str(countArray(gDB, orgs)) + ",\"orgs\":" + orgs + "}")
    return
  }
  res = errRes("404 Not Found", "not_found", "no such route")
}

// headersJSON serializes the request headers for the script. MFL cannot
// enumerate a JSON object, but machweb hands us a real map, so this is the
// one place the header set is turned into JSON by hand.
// A script names its headers however it likes ("Content-Type", "content-type"),
// so the lookup is case-insensitive over the keys the script actually sent.
func headerFromJSON(hdrs, want) (out) {
  out = ""
  rows := sqlite_query(gDB, "SELECT key AS k, 0 AS n FROM json_each(?)", []string{hdrs})
  if rows == "[]" { return }
  parsed := parse(rows, []GroupRow{})
  i := 0
  while i < len(parsed) {
    if to_lower(parsed[i].k) == want {
      v, e := json_get(hdrs, "." + parsed[i].k)
      if e == "" { out = jsonUnquote(v)  return }
    }
    i = i + 1
  }
}

func headersJSON(req) (out) {
  parts := []string{}
  for _, k := range keys(req.headers) {
    parts = append(parts, jsonQuote(k) + ":" + jsonQuote(req.headers[k]))
  }
  out = "{" + join(parts, ",") + "}"
}

func clientIP(req) (ip) {
  ip = header(req, "x-forwarded-for")
  comma := index(ip, ",")
  if comma > 0 { ip = substr(ip, 0, comma) }
  ip = trim(ip)
  if ip == "" { ip = header(req, "x-real-ip") }
  if ip == "" { ip = "local" }
}

// hooksRoutes is the only unauthenticated write path in the server. A hook
// hands the request to a script and returns whatever the script decided.
func hooksRoutes(req, q, segs) (res) {
  name := segs[2]
  h, found := findHook(gDB, name)
  if !found { res = errRes("404 Not Found", "not_found", "no such hook")  return }
  if h.enabled != 1 { res = errRes("404 Not Found", "not_found", "no such hook")  return }

  origin := header(req, "origin")

  // Only the preflight is handled for us; every other method reaches the
  // script, which branches on d.method.
  if req.method == "OPTIONS" {
    if !originAllowed(h.allow_origin, origin) {
      res = errRes("403 Forbidden", "origin_refused", "origin is not allowed for this hook")
      return
    }
    r := response("204 No Content", "text/plain", "")
    r = with_header(r, "Access-Control-Allow-Origin", origin)
    r = with_header(r, "Access-Control-Allow-Methods", "GET, POST, PUT, PATCH, DELETE, OPTIONS")
    r = with_header(r, "Access-Control-Allow-Headers", "Content-Type, Authorization")
    r = with_header(r, "Access-Control-Max-Age", "600")
    res = r
    return
  }

  if h.max_bytes > 0 {
    if len(req.body_bytes) > h.max_bytes {
      res = errRes("413 Payload Too Large", "too_large", "body exceeds this hook's limit of " + str(h.max_bytes) + " bytes")
      return
    }
  }
  if !rateOK(gDB, name, clientIP(req), h.rate_limit) {
    res = errRes("429 Too Many Requests", "rate_limited", "too many requests for this hook")
    return
  }

  // The body reaches the script byte for byte. A signature covers exact
  // bytes, so re-serializing before hashing would break every provider.
  d := "{\"method\":" + jsonQuote(req.method) + ",\"path\":" + jsonQuote(pathOnly(req.path)) + ",\"query\":" + queryJSON(q) + ",\"headers\":" + headersJSON(req) + ",\"body\":" + jsonQuote(req.body) + ",\"body_base64\":" + jsonQuote(base64_encode_bytes(req.body_bytes)) + ",\"ip\":" + jsonQuote(clientIP(req)) + "}"

  value, err := runScript(gDB, h.script, d)
  if err != "" {
    // A throwing hook answers 500 so the provider retries.
    res = jsonRes("500 Internal Server Error", "{\"ok\":false,\"error\":{\"type\":\"script_error\",\"message\":" + jsonQuote(err) + "}}")
    return
  }

  status := "200 OK"
  st, stErr := json_get(value, ".status")
  if stErr == "" { status = statusLine(st) }
  hdrs, hdrErr := json_get(value, ".headers")
  ctype := jsonField(value, ".content_type")
  // A script declares its content type the way every HTTP handler does -- in
  // `headers` -- so that is looked at too. Reading only `.content_type` left a
  // CSV export as a JSON-encoded string under a second, contradictory
  // Content-Type header.
  if ctype == "" {
    if hdrErr == "" { ctype = headerFromJSON(hdrs, "content-type") }
  }
  if ctype == "" { ctype = "application/json" }
  body, bodyErr := json_get(value, ".body")
  if bodyErr != "" { body = value }

  // A string body with a non-JSON content type is written verbatim, so a CSV
  // stays a CSV; anything else is JSON.
  r := response(status, ctype, body)
  if has_prefix(body, "\"") {
    if index(ctype, "json") < 0 { r = response(status, ctype, jsonUnquote(body)) }
  }
  if originAllowed(h.allow_origin, origin) { r = with_header(r, "Access-Control-Allow-Origin", origin) }

  // A script that returns headers gets them verbatim. Caching, a redirect's
  // Location and a conditional GET's ETag are all decisions the handler owns:
  // the core cannot know a bundle's identity or a rule's target.
  if hdrErr == "" {
    rows := sqlite_query(gDB, "SELECT key AS k, 0 AS n FROM json_each(?)", []string{hdrs})
    if rows != "[]" {
      parsed := parse(rows, []GroupRow{})
      i := 0
      while i < len(parsed) {
        name := parsed[i].k
        // response() already wrote Content-Type; with_header appends rather
        // than replaces, so re-emitting it here is how a response ends up
        // carrying two contradictory ones.
        if to_lower(name) != "content-type" {
          v, e := json_get(hdrs, "." + name)
          if e == "" { r = with_header(r, name, jsonUnquote(v)) }
        }
        i = i + 1
      }
    }
  }
  res = r
}

func queryJSON(q) (out) {
  parts := []string{}
  i := 0
  while i < len(q.keys) {
    parts = append(parts, jsonQuote(q.keys[i]) + ":" + jsonQuote(q.vals[i]))
    i = i + 1
  }
  out = "{" + join(parts, ",") + "}"
}

func statusLine(code) (s) {
  s = "200 OK"
  if code == "301" { s = "301 Moved Permanently" }
  if code == "302" { s = "302 Found" }
  if code == "303" { s = "303 See Other" }
  if code == "304" { s = "304 Not Modified" }
  if code == "308" { s = "308 Permanent Redirect" }
  if code == "410" { s = "410 Gone" }
  if code == "201" { s = "201 Created" }
  if code == "202" { s = "202 Accepted" }
  if code == "204" { s = "204 No Content" }
  if code == "400" { s = "400 Bad Request" }
  if code == "401" { s = "401 Unauthorized" }
  if code == "403" { s = "403 Forbidden" }
  if code == "404" { s = "404 Not Found" }
  if code == "409" { s = "409 Conflict" }
  if code == "422" { s = "422 Unprocessable Entity" }
  if code == "429" { s = "429 Too Many Requests" }
  if code == "500" { s = "500 Internal Server Error" }
}

func eventsRoutes(req, q, segs) (res) {
  if !authed(req, gAdmin, gHost) { res = errRes("403 Forbidden", "not_authenticated", "missing or invalid bearer token")  return }

  if len(segs) == 2 {
    streams, count := listStreams(gDB)
    res = jsonRes("200 OK", "{\"ok\":true,\"count\":" + str(count) + ",\"streams\":" + streams + "}")
    return
  }

  stream := segs[2]

  if len(segs) == 4 {
    if segs[3] == "stats" {
      groups, total, err := eventStats(gDB, stream, qGet(q, "by"), qGet(q, "since"))
      if err != "" { res = errRes("400 Bad Request", "validation_error", err)  return }
      res = jsonRes("200 OK", "{\"ok\":true,\"total\":" + str(total) + ",\"groups\":" + groups + "}")
      return
    }
    res = errRes("404 Not Found", "not_found", "no such route")
    return
  }

  if req.method == "POST" {
    out, err := emitEvent(gDB, stream, jsonField(req.body, ".type"), jsonField(req.body, ".level"), jsonField(req.body, ".source"), jsonField(req.body, ".subject"), jsonField(req.body, ".data"))
    if err != "" { res = errRes("400 Bad Request", "validation_error", err)  return }
    res = jsonRes("201 Created", "{\"ok\":true,\"event\":" + out + "}")
    return
  }

  events, count, err := listEvents(gDB, stream, qGet(q, "type"), qGet(q, "level"), qGet(q, "source"), qGet(q, "subject"), qGet(q, "since"), qGet(q, "until"), qInt(q, "limit", 50), qInt(q, "offset", 0))
  if err != "" { res = errRes("400 Bad Request", "validation_error", err)  return }
  res = jsonRes("200 OK", "{\"ok\":true,\"count\":" + str(count) + ",\"events\":" + events + "}")
}

func cronRoutes(req, q, segs) (res) {
  if !authed(req, gAdmin, gHost) { res = errRes("403 Forbidden", "not_authenticated", "missing or invalid bearer token")  return }

  if len(segs) == 2 {
    jobs, count := listJobs(gDB)
    running := "false"
    if gScheduler == 1 { running = "true" }
    res = jsonRes("200 OK", "{\"ok\":true,\"count\":" + str(count) + ",\"scheduler_running\":" + running + ",\"jobs\":" + jobs + "}")
    return
  }

  name := segs[2]

  if len(segs) == 4 {
    if segs[3] == "run" {
      out, err := runJob(gDB, name)
      if err != "" { res = errRes("404 Not Found", "not_found", err)  return }
      res = jsonRes("200 OK", "{\"ok\":true,\"result\":" + out + "}")
      return
    }
    res = errRes("404 Not Found", "not_found", "no such route")
    return
  }

  j, found := findJob(gDB, name)
  if !found { res = errRes("404 Not Found", "not_found", "job not found")  return }
  res = jsonRes("200 OK", "{\"ok\":true,\"job\":" + jobJSON(j) + "}")
}

// Who is asking, as the script will see them. Admin is decided first: an admin
// token is not a user token and must not be looked up as one.
func callerOf(req) (kind, sub, org) {
  kind = "anon"
  sub = ""
  org = ""
  if authed(req, gAdmin, gHost) { kind = "admin"  return }
  tok := bearer(req)
  if tok == "" { return }
  whoJ, whoClaims, whoErr := meFromToken(gDB, tok)
  if whoErr != "" { return }
  kind = "user"
  sub = jsonField(whoJ, ".id")
  org = jsonField(whoClaims, ".org")
}

// 401 when a credential would help, 403 when it would not. A script the caller
// may not run is also indistinguishable from one that does not exist, or a 404
// becomes a way to enumerate what an operator installed.
func mayRun(access, kind) (allow, status, code, msg) {
  allow = false
  status = "403 Forbidden"
  code = "not_authenticated"
  msg = "no such script"
  if access == "public" { allow = true  return }
  if kind == "admin" { allow = true  return }
  if access == "user" {
    if kind == "user" { allow = true  return }
    status = "401 Unauthorized"
    code = "not_authenticated"
    msg = "this script needs a signed-in caller"
    return
  }
}

func scriptRunRoute(req, name) (res) {
  kind, sub, org := callerOf(req)
  s, found := findScript(gDB, name)
  access := ""
  if found { access = runAccessOf(s) }
  // An unknown script is judged as if it were the most closed thing it could
  // be, so "does not exist" and "you may not run it" look the same from outside.
  if !found { access = "admin" }
  allow, status, code, msg := mayRun(access, kind)
  if !allow { res = errRes(status, code, msg)  return }
  if !found { res = errRes("404 Not Found", "not_found", "no such script")  return }

  started := now_ms()
  value, err := runScriptAs(gDB, name, req.body, callerJSON(kind, sub, org))
  took := now_ms() - started
  if err != "" {
    res = jsonRes("200 OK", "{\"ok\":false,\"status\":\"error\",\"took_ms\":" + str(took) + ",\"error\":" + jsonQuote(err) + ",\"value\":null}")
    return
  }
  res = jsonRes("200 OK", "{\"ok\":true,\"status\":\"ok\",\"took_ms\":" + str(took) + ",\"value\":" + value + "}")
}

func scriptRoutes(req, q, segs) (res) {
  // The run route carries its own policy, so it is handled before the blanket
  // admin gate that protects creating, listing and deleting scripts.
  if len(segs) == 4 {
    if segs[3] == "run" {
      if req.method == "POST" {
        res = scriptRunRoute(req, segs[2])
        return
      }
    }
  }
  if !authed(req, gAdmin, gHost) { res = errRes("403 Forbidden", "not_authenticated", "missing or invalid bearer token")  return }

  if len(segs) == 2 {
    scripts, count := listScripts(gDB)
    res = jsonRes("200 OK", "{\"ok\":true,\"count\":" + str(count) + ",\"scripts\":" + scripts + "}")
    return
  }

  name := segs[2]

  if len(segs) == 4 {
    if segs[3] == "run" {
      res = errRes("405 Method Not Allowed", "method_not_allowed", "a script is run with POST")
      return
    }
    if segs[3] == "runs" {
      runs, count := listRuns(gDB, name, qInt(q, "limit", 20))
      res = jsonRes("200 OK", "{\"ok\":true,\"count\":" + str(count) + ",\"runs\":" + runs + "}")
      return
    }
    res = errRes("404 Not Found", "not_found", "no such route")
    return
  }

  s, found := findScript(gDB, name)
  if !found { res = errRes("404 Not Found", "not_found", "script not found")  return }
  res = jsonRes("200 OK", "{\"ok\":true,\"script\":" + scriptJSON(s) + "}")
}

func filesRoutes(req, q, segs) (res) {
  // A private namespace answers 404, not 403: an unauthenticated caller
  // should not be able to map which namespaces exist.
  if len(segs) == 2 {
    if !authed(req, gAdmin, gHost) { res = errRes("403 Forbidden", "not_authenticated", "missing or invalid bearer token")  return }
    nss := listNs(gDB)
    res = jsonRes("200 OK", "{\"ok\":true,\"count\":" + str(countArray(gDB, nss)) + ",\"namespaces\":" + nss + "}")
    return
  }

  ns := segs[2]
  n, nsFound := findNs(gDB, ns)
  isAdmin := authed(req, gAdmin, gHost)
  if !nsFound {
    if !isAdmin { res = errRes("404 Not Found", "not_found", "no such file")  return }
    res = errRes("404 Not Found", "not_found", "namespace not found")
    return
  }

  if len(segs) == 3 {
    if !isAdmin { res = errRes("404 Not Found", "not_found", "no such file")  return }
    files, count := listFiles(gDB, ns, qInt(q, "limit", 50), qInt(q, "offset", 0))
    res = jsonRes("200 OK", "{\"ok\":true,\"count\":" + str(count) + ",\"files\":" + files + "}")
    return
  }

  name := segs[3]

  if req.method == "POST" || req.method == "PUT" {
    if !isAdmin { res = errRes("403 Forbidden", "not_authenticated", "missing or invalid bearer token")  return }
    out, err, kind := putFile(gDB, ns, name, req.body_bytes, header(req, "content-type"), qGet(q, "meta"))
    if err != "" {
      status := "400 Bad Request"
      if kind == "not_found" { status = "404 Not Found" }
      if kind == "too_large" { status = "413 Payload Too Large" }
      if kind == "type_refused" { status = "415 Unsupported Media Type" }
      if kind == "internal_error" { status = "500 Internal Server Error" }
      res = errRes(status, kind, err)
      return
    }
    res = jsonRes("201 Created", "{\"ok\":true,\"file\":" + out + "}")
    return
  }

  if req.method == "DELETE" {
    if !isAdmin { res = errRes("403 Forbidden", "not_authenticated", "missing or invalid bearer token")  return }
    err := deleteFile(gDB, ns, name)
    if err != "" { res = errRes("404 Not Found", "not_found", err)  return }
    res = jsonRes("200 OK", "{\"ok\":true,\"deleted\":true}")
    return
  }

  if n.public != 1 {
    // A signed link is a credential in itself: it names one file and carries
    // its own expiry, so it opens a private namespace without a token. It is
    // checked before the admin fallback so an expired link fails as a 404
    // rather than leaking that the file exists.
    signed := signatureValid(gDB, ns, name, qGet(q, "sig"), qGet(q, "exp"))
    if !signed {
      if !isAdmin { res = errRes("404 Not Found", "not_found", "no such file")  return }
    }
  }
  f, found := findFile(gDB, ns, name)
  if !found { res = errRes("404 Not Found", "not_found", "no such file")  return }

  // The digest is the ETag, so a conditional GET is exact rather than
  // heuristic: same bytes, same tag, always.
  if header(req, "if-none-match") == "\"" + f.sha256 + "\"" {
    res = fileHeaders(response("304 Not Modified", f.ctype, ""), f)
    return
  }
  res = fileHeaders(ok_bytes(f.ctype, readBlob(f.sha256)), f)
}

func kvRoutes(req, q, segs) (res) {
  if len(segs) == 2 {
    // ?public=1 is the one unauthenticated listing; anything broader needs
    // the token.
    publicOnly := qGet(q, "public") == "1"
    if !publicOnly {
      if !authed(req, gAdmin, gHost) {
        res = errRes("403 Forbidden", "not_authenticated", "listing non-public entries requires a bearer token")
        return
      }
    }
    entries := kvList(gDB, qGet(q, "prefix"), publicOnly)
    res = jsonRes("200 OK", "{\"ok\":true,\"count\":" + str(countArray(gDB, entries)) + ",\"entries\":" + entries + "}")
    return
  }

  key := segs[2]
  if req.method == "GET" {
    // Decided on metadata alone. Decrypting first would let a decrypt error
    // reveal that a private key exists.
    meta, found := kvMeta(gDB, key)
    if !found { res = errRes("404 Not Found", "not_found", "key not found")  return }
    if meta.public != 1 {
      if !authed(req, gAdmin, gHost) {
        // The same answer as a missing key: whether a private setting exists
        // is itself information.
        res = errRes("404 Not Found", "not_found", "key not found")
        return
      }
    }
    entry, _, err := kvGet(gDB, key)
    if err != "" { res = errRes("500 Internal Server Error", "internal_error", err)  return }
    res = jsonRes("200 OK", "{\"ok\":true,\"entry\":" + entry + "}")
    return
  }

  if !authed(req, gAdmin, gHost) {
    res = errRes("403 Forbidden", "not_authenticated", "missing or invalid bearer token")
    return
  }
  if req.method == "POST" {
    kind := jsonField(req.body, ".type")
    if kind == "" { kind = "string" }
    public := jsonField(req.body, ".public") == "true"
    entry, err := kvSet(gDB, key, jsonField(req.body, ".value"), kind, jsonField(req.body, ".description"), public)
    if err != "" { res = errRes("400 Bad Request", "validation_error", err)  return }
    res = jsonRes("200 OK", "{\"ok\":true,\"entry\":" + entry + "}")
    return
  }
  if req.method == "DELETE" {
    if !kvDelete(gDB, key) { res = errRes("404 Not Found", "not_found", "key not found")  return }
    res = jsonRes("200 OK", "{\"ok\":true,\"deleted\":" + jsonQuote(key) + "}")
    return
  }
  res = errRes("405 Method Not Allowed", "method_not_allowed", "unsupported method " + req.method)
}

// Takes the handle rather than reading gDB: gDB is set only by the server, so
// this silently answered 0 for every CLI caller -- `store list` reported
// "count": 0 next to two records.
func countArray(db, arr) (n) {
  n = 0
  rows := sqlite_query(db, "SELECT COUNT(*) AS c FROM json_each(?)", []string{arr})
  if rows == "[]" { return }
  v, e := json_get(rows, "[0].c")
  if e == "" { n = int(parse(v, 0)) }
}

func handle(req) (res) {
  q := parseQuery(req.path)
  segs := segments(req.path)

  // Open by design: a liveness probe that needs a credential cannot tell you
  // that credentials are what is broken.
  if len(segs) == 1 {
    // Both are public: the guide is documentation and contains no secrets, and
    // an agent that knows only the host must be able to orient itself.
    if segs[0] == "guide" {
      res = jsonRes("200 OK", guideJSON())
      return
    }
    if segs[0] == "llms.txt" {
      res = response("200 OK", "text/plain; charset=utf-8", llmsTXT())
      return
    }
    if segs[0] == "version" {
      res = jsonRes("200 OK", "{\"ok\":true,\"tool\":\"bkn\",\"tool_version\":" + jsonQuote(toolVersion()) + ",\"version\":\"1.0\"}")
      return
    }
    if segs[0] == "_health" {
      if sqlite_query(gDB, "SELECT 1 AS ok") == "[]" {
        res = jsonRes("503 Service Unavailable", "{\"ok\":false,\"service\":\"bkn\",\"reason\":\"datastore unreachable\"}")
        return
      }
      res = jsonRes("200 OK", "{\"ok\":true,\"service\":\"bkn\",\"pid\":0}")
      return
    }
  }

  if len(segs) >= 3 {
    if segs[0] == "v1" {
      if segs[1] == "auth" {
        res = authRoutes(req, q, segs)
        return
      }
    }
  }

  if len(segs) >= 2 {
    if segs[0] == "v1" {
      if segs[1] == "hooks" {
        res = hooksRoutes(req, q, segs)
        return
      }
      if segs[1] == "events" {
        res = eventsRoutes(req, q, segs)
        return
      }
      if segs[1] == "cron" {
        res = cronRoutes(req, q, segs)
        return
      }
      if segs[1] == "script" {
        res = scriptRoutes(req, q, segs)
        return
      }
      if segs[1] == "files" {
        res = filesRoutes(req, q, segs)
        return
      }
      if segs[1] == "kv" {
        res = kvRoutes(req, q, segs)
        return
      }
    }
  }

  if len(segs) >= 3 {
    if segs[0] == "v1" {
      if segs[1] == "store" {
        // The policy is decided ONCE, here, and handed to the routes as a scope.
        // A route that had to re-derive it could implement half of it.
        storeAdmin := authed(req, gAdmin, gHost)
        storeTok := bearer(req)
        storeSub := ""
        storeOrg := ""
        if storeTok != "" {
          if !storeAdmin {
            whoJ, whoClaims, whoErr := meFromToken(gDB, storeTok)
            if whoErr == "" {
              storeSub = jsonField(whoJ, ".id")
              storeOrg = jsonField(whoClaims, ".org")
            }
          }
        }
        storeAcc := accessOf(gDB, segs[2], segs[3])
        dec := decideAccess(gDB, storeAcc, verbFor(req.method, len(segs) >= 5), storeAdmin, storeTok != "", storeSub, storeOrg)
        if !dec.allow {
          res = errRes(dec.status, dec.kind, dec.msg)
          return
        }
        r, handled := storeRoutes(req, q, segs, dec)
        if handled { res = r  return }
      }
    }
  }

  res = errRes("404 Not Found", "not_found", "no such route")
}

func main() {
  // The id keeper is the lock guarding ULID minting; nothing may call newID()
  // before it runs, and the CLI paths below mint ids too, so it starts first.
  go ulidKeeper()
  a := args()
  if len(a) > 1 {
    if a[1] != "serve" {
      code := runCLI(a)
      if code != 0 { exit(code) }
      return
    }
  }
  path := env("BKN_DATA")
  if path == "" { path = "bkn.db" }
  gAdmin = env("BKN_ADMIN_TOKEN")
  gHost = env("BKN_HOST")
  if gHost == "" { gHost = "127.0.0.1" }
  port := 7799
  p := env("BKN_PORT")
  if p != "" { if looksNumeric(p) { port = int(parse(p, 0)) } }
  // Flags win over the environment: a harness that starts its own instance on
  // a random port says so on the command line.
  fi := 2
  while fi < len(a) {
    if a[fi] == "--host" { if fi+1 < len(a) { gHost = a[fi+1] } }
    if a[fi] == "--port" { if fi+1 < len(a) { if looksNumeric(a[fi+1]) { port = int(parse(a[fi+1], 0)) } } }
    fi = fi + 1
  }

  gDB = storeOpen(path)
  // A store written before policies existed gains the column on open.
  accessMigrate(gDB)
  scriptMigrate(gDB)
  filesMigrate(gDB)
  if gDB == 0 { println("cannot open " + path)  return }
  // The scheduler is part of the server, not a separate process: a job that
  // only fires when someone remembers to run a ticker is not a schedule.
  gScheduler = 1
  go schedulerLoop(gDB)

  // Announce the intent, not the outcome: this used to claim "listening" before
  // the bind was attempted, so a port already in use printed a success line and
  // exited 0. A stale server then kept serving an old database while a test run
  // believed it was talking to the new one -- which is exactly how a green
  // suite turned into 13 mysterious failures.
  println("[serve] starting on http://" + gHost + ":" + str(port))
  // serve_on, NOT serve: serve() binds INADDR_ANY, so --host was decorative
  // and an operator who asked for 127.0.0.1 or a private address got the whole
  // internet instead. serve_on exits on a bind failure rather than returning.
  serve_on(gHost, port, func(req) { return handle(req) })
  println("[serve] could not bind " + gHost + ":" + str(port) + " — is another instance already running?")
  exit(75)
}
