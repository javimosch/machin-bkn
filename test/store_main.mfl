
func expect(label, got, want) {
  if got == want {
    println("  ok   " + label)
  } else {
    println("  FAIL " + label + ": got [" + got + "] want [" + want + "]")
  }
}

func main() {
  db := storeOpen(":memory:")
  if db == 0 { println("open failed")  return }

  ns, coll, err := splitRef("myapp/users")
  expect("ref splits", ns + "|" + coll + "|" + err, "myapp|users|")
  _, _, e2 := splitRef("users")
  expect("ref needs a slash", e2, "collection ref must be <namespace>/<collection>")
  _, _, e3 := splitRef("MyApp/users")
  expect("ref rejects caps", e3, "collection ref must be <namespace>/<collection>")
  _, _, e4 := splitRef("9app/users")
  expect("ref rejects leading digit", e4, "collection ref must be <namespace>/<collection>")
  _, _, e5 := splitRef("my-app_2/user_records")
  expect("ref allows - and _", e5, "")

  ensureCollection(db, "myapp", "users")
  setNormalizers(db, "myapp", "users", "{\"email\":\"trim_lower\"}")
  expect("normalizers stored", normalizersOf(db, "myapp", "users"), "{\"email\":\"trim_lower\"}")
  expect("rule lookup", ruleFor("{\"email\":\"trim_lower\"}", "email"), "trim_lower")
  expect("normalize expr", normalizeExpr("trim_lower", "X"), "lower(trim(X))")

  rules := normalizersOf(db, "myapp", "users")
  got := applyNormalizers(db, "{\"email\":\"  Ada@Example.IO \",\"name\":\"Ada\"}", rules)
  expect("normalizer applied", got, "{\"email\":\"ada@example.io\",\"name\":\"Ada\"}")

  untouched := applyNormalizers(db, "{\"email\":42}", rules)
  expect("non-string untouched", untouched, "{\"email\":42}")

  sqlite_close(db)
}
